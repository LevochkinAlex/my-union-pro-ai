# База данных — VK Cloud PostgreSQL (локальная разработка и прод используют одну БД)
# Хост: 83.166.237.161:5432, БД: myunion_db. В пароле запятую в URL кодировать как %2C.
# DATABASE_URL="postgresql://myadminunion:YOUR_PASSWORD%2CENCODED@83.166.237.161:5432/myunion_db"

# NEXTAUTH_URL="http://localhost:3004"
# NEXTAUTH_SECRET="your-secret"

# RunwayML API Configuration
RUNWAYML_API_KEY=""
RUNWAYML_API_VERSION="2024-11-06"

# Заявки «ППО нет в списке» — адрес для уведомлений (если не задано: ADMIN_EMAIL или SMTP_USER)
# PPO_REQUEST_EMAIL=
# ADMIN_EMAIL=

# MAX Messenger — токен бота (платформа MAX для партнёров → Интеграция → Получить токен). Нужен для отправки PIN и для входа через мини-приложение.
# MAX_BOT_TOKEN=your_bot_token
# Имя бота в MAX для QR на странице входа (из кабинета MAX: id у бота, например id9707055804_bot). Если задано — в QR диплинк max.ru/BotName?startapp.
# NEXT_PUBLIC_MAX_BOT_USERNAME=id9707055804_bot

# CDN (VK Cloud) — для раздачи загруженных файлов
# NEXT_PUBLIC_CDN_URL=https://cdn.myunion.pro

# Сокет для realtime-чата (опционально). По умолчанию хост:3005. Если не задано и сокет-сервер не запущен — чат работает по HTTP.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3005
