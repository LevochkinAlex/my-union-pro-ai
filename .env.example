# База данных — ТОЛЬКО удалённая VK Cloud (83.166.237.161). Локальной БД в проекте нет.
# Локальная разработка и прод подключаются к одной и той же БД. Не менять на localhost/194.87.49.210.
# DATABASE_URL="postgresql://myadminunion:YOUR_PASSWORD%2CENCODED@83.166.237.161:5432/myunion_db"

# NEXTAUTH_URL="http://localhost:3004"
# NEXTAUTH_SECRET="your-secret"

# T-Bank интернет-эквайринг (тестовый/боевой терминал). Для деплоя: задайте в vds.deploy.env или .env.local — complete-deploy.sh подставит на прод.
# Документация: https://developer.tbank.ru/eacq/intro
# TBANK_TERMINAL_KEY="1772104554689"
# TBANK_TERMINAL_PASSWORD="your_terminal_password"
# TBANK_API_BASE_URL="https://securepay.tinkoff.ru/v2"

# RunwayML API Configuration
RUNWAYML_API_KEY=""
RUNWAYML_API_VERSION="2024-11-06"

# Заявки «ППО нет в списке» — адрес для уведомлений (если не задано: ADMIN_EMAIL или SMTP_USER)
# PPO_REQUEST_EMAIL=
# ADMIN_EMAIL=

# MAX Messenger — токен бота (платформа MAX для партнёров → Интеграция → Получить токен). Нужен для отправки PIN и для входа через мини-приложение.
# MAX_BOT_TOKEN=your_bot_token
# Имя бота в MAX для QR на странице входа (из кабинета MAX: id у бота, например id9707055804_bot). Если задано — в QR диплинк max.ru/BotName?startapp.
# NEXT_PUBLIC_MAX_BOT_USERNAME=id9707055804_bot

# VK ID (id.vk.com) — вход через ВКонтакте / ОК / Mail. Кабинет: https://id.vk.com/about/business/go
# VK_ID_CLIENT_ID=идентификатор приложения (из параметров приложения после создания Web app)
# В настройках приложения укажите Trusted redirect URL: https://myunion.pro/api/auth/vk-id/callback

# CDN (VK Cloud) — для раздачи загруженных файлов
# NEXT_PUBLIC_CDN_URL=https://cdn.myunion.pro

# Сокет для realtime-чата (опционально). По умолчанию хост:3005. Если не задано и сокет-сервер не запущен — чат работает по HTTP.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3005

# Роли сотрудников: true = управление ролями только в РПО («Роли и должности»), в ППО — только просмотр и назначение.
# false = председатель ППО может создавать/редактировать роли локально (legacy).
# RPO_ROLE_TEMPLATES_ENABLED=true
