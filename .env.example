# Локальная разработка (обязательно для работы приложения)
# Для dev используйте локальную БД (localhost). Продакшен-хост с вашей машины часто недоступен.
# DATABASE_URL="postgresql://user:password@localhost:5432/myunion"
# Или туннель до прода: ssh -L 5432:localhost:5432 root@194.87.49.210

# VK Cloud PostgreSQL (если перенесли БД):
# Server=83.166.237.161 Port=5432. В пароле запятую в URL кодировать как %2C.
# DATABASE_URL="postgresql://myadminunion:PASSWORD%2CENCODED@83.166.237.161:5432/myunion_db"

# NEXTAUTH_URL="http://localhost:3004"
# NEXTAUTH_SECRET="your-secret"

# RunwayML API Configuration
RUNWAYML_API_KEY=""
RUNWAYML_API_VERSION="2024-11-06"

# Заявки «ППО нет в списке» — адрес для уведомлений (если не задано: ADMIN_EMAIL или SMTP_USER)
# PPO_REQUEST_EMAIL=
# ADMIN_EMAIL=
