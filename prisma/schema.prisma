generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли пользователей
enum UserRole {
  MEMBER // Обычный член профсоюза
  PENDING_MEMBER // Ожидает одобрения
  PPO_HEAD // Председатель ППО
  REGIONAL_CHAIRMAN // Председатель регионального отделения
  FEDERAL_CHAIRMAN // Председатель федерации
  SUPER_ADMIN // Суперадмин
}

// Статусы членства
enum MembershipStatus {
  PENDING_VERIFICATION // Ожидает проверки email
  PROFILE_INCOMPLETE // Email подтвержден, профиль не заполнен
  DOCUMENTS_PENDING // Документы отправлены на проверку
  APPROVED // Одобрен как член профсоюза
  REJECTED // Отклонен
  SUSPENDED // Приостановлен
}

// Типы организаций
enum OrganizationType {
  PRIMARY // Первичная профсоюзная организация (ППО)
  REGIONAL // Региональное отделение
  FEDERAL // Федерация
}

// Пользователь
model User {
  id               String           @id @default(cuid())
  email            String           @unique
  password         String?
  role             UserRole         @default(PENDING_MEMBER)
  membershipStatus MembershipStatus @default(PENDING_VERIFICATION)

  // Персональные данные
  firstName   String?
  lastName    String?
  middleName  String?
  dateOfBirth DateTime?
  phone       String?
  address     String?
  region      String? // Регион России

  // Профессиональная информация
  jobTitle   String? // Занимаемая должность
  profession String? // Основная профессия
  education  String? // Образование

  // Подпись (путь к файлу на сервере)
  signaturePath String?

  // Организация
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Заявления
  documents Document[]

  // Email верификация
  emailVerified       DateTime?
  verificationToken   String?   @unique
  verificationExpires DateTime?

  // Сброс пароля
  resetToken        String?   @unique
  resetTokenExpires DateTime?

  // Чат с AI
  chatMessages               ChatMessage[]
  chatSessions               ChatSession[]
  updatedSettings            SystemSetting[]     @relation("SystemSettingUpdatedBy")
  uploadedKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeDocumentUploadedBy")

  // Обращения
  appeals UserAppeal[]

  // Push Notifications
  pushSubscriptions PushSubscription[]

  // Настройки уведомлений
  pushNotificationsEnabled Boolean @default(true) // Включены ли push уведомления
  pushSoundEnabled         Boolean @default(true) // Включен ли звук в push уведомлениях
  emailBotNotifications    Boolean @default(false) // Email уведомления от бота (по умолчанию выключено)
  emailAppealNotifications  Boolean @default(true) // Email уведомления по обращениям (по умолчанию включено)

  // System Logs
  systemLogs SystemLog[]
  resolvedLogs SystemLog[] @relation("ResolvedLogs")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([organizationId])
  @@index([verificationToken])
  @@index([resetToken])
}

// Организация (ППО, региональные, федерация)
model Organization {
  id   String           @id @default(cuid())
  name String
  type OrganizationType

  // Иерархия
  parentId String?
  parent   Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrganizationHierarchy")

  // Контакты
  inn     String? @unique
  address String?
  phone   String?
  email   String?

  // Председатель
  chairmanName String?

  // Члены
  members User[]

  // Документы организации
  documents Document[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([parentId])
  @@index([inn])
}

// Типы документов
enum DocumentType {
  MEMBERSHIP_APPLICATION // Заявление о вступлении в ППО
  CONTRIBUTION_APPLICATION // Заявление о взносах
  APPEAL // Обращение
  OTHER // Прочее
}

// Статусы документов
enum DocumentStatus {
  DRAFT // Черновик
  GENERATED // Сгенерирован
  SIGNED // Подписан
  PENDING // Ожидает проверки
  APPROVED // Одобрен
  REJECTED // Отклонен
  ARCHIVED // В архиве
}

// Документ (заявления, обращения)
model Document {
  id     String         @id @default(cuid())
  type   DocumentType
  status DocumentStatus @default(GENERATED)

  // Содержимое
  title       String
  content     String? @db.Text
  description String? @db.Text

  // Файлы (PDF и подписанные копии)
  filePath       String? // Сгенерированный PDF
  signedFilePath String? // Подписанный скан
  fileName       String? // Имя файла
  fileSize       Int? // Размер в байтах
  mimeType       String  @default("application/pdf")

  // Google Drive хранение
  driveFileId String? @unique // ID файла в Google Drive
  driveUrl    String? // Публичная ссылка на файл

  // Владелец
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Организация
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Комментарий при отклонении
  rejectionReason String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([driveFileId])
}

// Сессии чата
enum ChatSessionType {
  STATEMENT // Чат для создания заявления
  APPEAL    // Чат для обращения
}

model ChatSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String // Название сессии (например, "Заявление" или "Обращение №123456")
  type  ChatSessionType @default(STATEMENT)

  // Сообщения в этой сессии
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// Сообщения AI чата для сбора данных профиля
model ChatMessage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  chatBotId String?
  chatBot   ChatBot? @relation(fields: [chatBotId], references: [id], onDelete: SetNull)

  appealId String?
  appeal   UserAppeal? @relation(fields: [appealId], references: [id], onDelete: Cascade)

  role    String // "user" или "assistant"
  content String @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([chatBotId])
  @@index([appealId])
  @@index([createdAt])
}

// Удалено: Новости (для будущего функционала) - не используется
// Удалено: Скидки (для будущего функционала) - не используется

// Настройки системы (SMTP, OpenRouter и т.д.)
model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String?  @db.Text
  updatedByUserId String?
  updatedBy       User?    @relation("SystemSettingUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([key])
}

