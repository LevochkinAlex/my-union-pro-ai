generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли пользователей
enum UserRole {
  MEMBER              // Обычный член профсоюза
  PENDING_MEMBER      // Ожидает одобрения
  PPO_HEAD            // Председатель ППО
  REGIONAL_CHAIRMAN   // Председатель регионального отделения
  FEDERAL_CHAIRMAN    // Председатель федерации
  SUPER_ADMIN         // Суперадмин
}

// Статусы членства
enum MembershipStatus {
  PENDING_VERIFICATION  // Ожидает проверки email
  PROFILE_INCOMPLETE    // Email подтвержден, профиль не заполнен
  DOCUMENTS_PENDING     // Документы отправлены на проверку
  APPROVED              // Одобрен как член профсоюза
  REJECTED              // Отклонен
  SUSPENDED             // Приостановлен
}

// Типы организаций
enum OrganizationType {
  PRIMARY        // Первичная профсоюзная организация (ППО)
  REGIONAL       // Региональное отделение
  FEDERAL        // Федерация
}

// Пользователь
model User {
  id                String            @id @default(cuid())
  email             String            @unique
  password          String?
  role              UserRole          @default(PENDING_MEMBER)
  membershipStatus  MembershipStatus  @default(PENDING_VERIFICATION)
  
  // Персональные данные
  firstName         String?
  lastName          String?
  middleName        String?
  dateOfBirth       DateTime?
  phone             String?
  address           String?
  
  // Профессиональная информация
  jobTitle          String?           // Занимаемая должность
  profession        String?           // Основная профессия
  education         String?           // Образование
  
  // Подпись (путь к файлу на сервере)
  signaturePath     String?
  
  // Организация
  organizationId    String?
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  
  // Заявления
  documents         Document[]
  
  // Email верификация
  emailVerified     DateTime?
  verificationToken String?           @unique
  verificationExpires DateTime?
  
  // Сброс пароля
  resetToken        String?           @unique
  resetTokenExpires DateTime?
  
  // Чат с AI
  chatMessages      ChatMessage[]
  updatedSettings   SystemSetting[]       @relation("SystemSettingUpdatedBy")
  uploadedTrainingSamples AiTrainingSample[] @relation("AiTrainingSampleUploadedBy")
  
  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([email])
  @@index([organizationId])
  @@index([verificationToken])
  @@index([resetToken])
}

// Организация (ППО, региональные, федерация)
model Organization {
  id            String              @id @default(cuid())
  name          String
  type          OrganizationType
  
  // Иерархия
  parentId      String?
  parent        Organization?       @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children      Organization[]      @relation("OrganizationHierarchy")
  
  // Контакты
  inn           String?             @unique
  address       String?
  phone         String?
  email         String?
  
  // Председатель
  chairmanName  String?
  
  // Члены
  members       User[]
  
  // Документы организации
  documents     Document[]
  
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  @@index([type])
  @@index([parentId])
  @@index([inn])
}

// Типы документов
enum DocumentType {
  MEMBERSHIP_APPLICATION    // Заявление о вступлении в ППО
  CONTRIBUTION_APPLICATION  // Заявление о взносах
  APPEAL                    // Обращение
  OTHER                     // Прочее
}

// Статусы документов
enum DocumentStatus {
  DRAFT           // Черновик
  PENDING         // Ожидает проверки
  APPROVED        // Одобрен
  REJECTED        // Отклонен
  ARCHIVED        // В архиве
}

// Документ (заявления, обращения)
model Document {
  id              String          @id @default(cuid())
  type            DocumentType
  status          DocumentStatus  @default(PENDING)
  
  // Содержимое
  title           String
  content         String?         @db.Text
  
  // Файлы (PDF и подписанные копии)
  filePath        String?         // Сгенерированный PDF
  signedFilePath  String?         // Подписанный скан
  
  // Владелец
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Организация
  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id])
  
  // Комментарий при отклонении
  rejectionReason String?         @db.Text
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
}

// Сообщения AI чата для сбора данных профиля
model ChatMessage {
  id        String   @id @default(cuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role      String   // "user" или "assistant"
  content   String   @db.Text
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// Новости (для будущего функционала)
model News {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  excerpt     String?
  coverImage  String?
  
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([publishedAt])
}

// Скидки (для будущего функционала)
model Discount {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  discount    String   // "10%", "2+1", "Фиксированная цена" и т.д.
  
  company     String   // Название компании
  category    String?  // Категория (Магазины, Рестораны, Услуги и т.д.)
  
  validFrom   DateTime
  validUntil  DateTime?
  
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

// Настройки системы (SMTP, OpenRouter и т.д.)
model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String?  @db.Text
  updatedByUserId String?
  updatedBy       User?    @relation("SystemSettingUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([key])
}

// Данные для обучения AI-чата
model AiTrainingSample {
  id               String   @id @default(cuid())
  question         String
  answer           String   @db.Text
  category         String?
  sourceFileName   String?
  uploadedByUserId String?
  uploadedBy       User?    @relation("AiTrainingSampleUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}
