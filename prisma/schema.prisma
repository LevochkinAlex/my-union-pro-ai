// База знаний (Knowledge Base) - как в Coze
model KnowledgeBase {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  // Документы в базе знаний
  documents KnowledgeDocument[]
  sources   KnowledgeSource[]
  chunks    KnowledgeChunk[]

  // Боты, использующие эту базу знаний
  bots ChatBotKnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Типы документов в базе знаний
enum KnowledgeSourceType {
  FILE
  URL
  WEB_SEARCH
  API
  MANUAL
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

enum ProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model KnowledgeSource {
  id              String                @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase         @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  type            KnowledgeSourceType
  url             String?
  title           String?
  metadata        Json?
  status          KnowledgeSourceStatus @default(PENDING)
  lastFetchedAt   DateTime?
  documents       KnowledgeDocument[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([type])
}

model KnowledgeDocument {
  id              String           @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          KnowledgeSource? @relation(fields: [sourceId], references: [id])

  // Метаданные файла
  fileName     String?
  originalName String
  filePath     String?
  mimeType     String?
  fileType     String?
  fileSize     Int?
  checksum     String?
  contentType  DocumentContentType @default(TEXT)

  // Обработка
  processingStatus ProcessingStatus @default(UPLOADED)
  processedAt      DateTime?
  extractedText    String?          @db.Text
  meta             Json?

  uploadedByUserId String?
  uploadedBy       User?   @relation("KnowledgeDocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  chunks KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([sourceId])
  @@index([processingStatus])
  @@index([contentType])
}

model KnowledgeChunk {
  id              String             @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId      String?
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content         String             @db.Text
  tokens          Int?
  embedding       Float[]
  metadata        Json?
  createdAt       DateTime           @default(now())

  @@index([knowledgeBaseId])
  @@index([documentId])
}

// База знаний о пользователе (для ИИ)
// Автоматически создается для каждого пользователя и хранит всю информацию о нем
model UserKnowledgeBase {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserKnowledgeBase", fields: [userId], references: [id], onDelete: Cascade)

  // Chunks с информацией о пользователе
  chunks UserKnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Фрагменты информации о пользователе с векторными представлениями
model UserKnowledgeChunk {
  id                  String            @id @default(cuid())
  userKnowledgeBaseId String
  userKnowledgeBase   UserKnowledgeBase @relation(fields: [userKnowledgeBaseId], references: [id], onDelete: Cascade)

  // Тип информации
  type UserKnowledgeChunkType

  // Содержимое фрагмента
  content String @db.Text

  // Векторное представление для поиска
  embedding Float[]

  // Метаданные (JSON)
  metadata Json?

  // Количество токенов
  tokens Int?

  // Источник информации (например, "profile_update", "ai_interaction", "document_generation")
  source String

  // Ссылка на связанную сущность (например, ID документа или сообщения)
  relatedEntityId   String?
  relatedEntityType String? // "document", "chat_message", "profile_update"

  createdAt DateTime @default(now())

  @@index([userKnowledgeBaseId])
  @@index([type])
  @@index([source])
  @@index([relatedEntityId])
}

// Типы фрагментов информации о пользователе
enum UserKnowledgeChunkType {
  PROFILE_DATA // Данные профиля (ФИО, телефон, адрес и т.д.)
  INTERACTION // Взаимодействие с ИИ (вопросы, ответы)
  DOCUMENT_CONTENT // Содержимое документов пользователя
  PREFERENCE // Предпочтения и настройки
  HISTORY // История действий (вступление, изменения статуса и т.д.)
  NOTE // Заметки администратора о пользователе
}

// Настройки AI бота (промпт, тон, контекст)
model ChatBot {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text

  // Системный промпт
  systemPrompt String @db.Text

  // Тон общения
  tone String @default("professional") // professional, friendly, formal, casual

  // Контекст (дополнительная информация)
  context String? @db.Text

  // Модель AI (например: openai/gpt-4o-mini, anthropic/claude-3-haiku и т.д.)
  model String @default("openai/gpt-4o-mini")

  // API провайдер
  apiProviderId String?
  apiProvider   ApiProvider? @relation(fields: [apiProviderId], references: [id])

  // Дополнительные настройки (для кастомных провайдеров или переопределений)
  providerOverride Json?

  // Температура для генерации (0-2)
  temperature Float @default(0.7)

  // Максимальное количество токенов (увеличено для поддержки сложных диалогов и развернутых ответов)
  // 16000 tokens ≈ 12000 слов - достаточно для самых сложных объяснений
  maxTokens Int @default(16000)

  // Базы знаний, используемые этим ботом
  knowledgeBases  ChatBotKnowledgeBase[]
  retrievalConfig Json?

  // Удалено: связь с ChatMessage (ChatMessage больше не используется)

  // Активен ли бот
  isActive Boolean @default(true)

  // Является ли ботом по умолчанию
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDefault])
  @@index([apiProviderId])
}

// Связь бота с базой знаний (many-to-many)
model ChatBotKnowledgeBase {
  id              String        @id @default(cuid())
  chatBotId       String
  chatBot         ChatBot       @relation(fields: [chatBotId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([chatBotId, knowledgeBaseId])
  @@index([chatBotId])
  @@index([knowledgeBaseId])
}

// Настройки API провайдеров (OpenRouter, OpenAI, Anthropic и т.д.)
model ApiProvider {
  id          String  @id @default(cuid())
  name        String  @unique // openrouter, openai, anthropic, custom
  displayName String // Отображаемое имя
  description String? @db.Text

  // API ключ (зашифрован или в открытом виде, зависит от реализации)
  apiKey String? @db.Text

  // Базовый URL для API
  apiBaseUrl String? @db.Text

  // Доступные модели для этого провайдера (JSON массив)
  availableModels String? @db.Text // JSON массив моделей
  capabilities    Json?

  // Активен ли провайдер
  isActive Boolean @default(true)

  // Является ли провайдером по умолчанию
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots ChatBot[]

  @@index([isActive])
  @@index([isDefault])
}

// Система тикетов (обращений)
enum TicketType {
  LEGAL // Юридическое обращение
  ACCOUNTING // Бухгалтерское обращение
  TECHNICAL // Техническая поддержка
  HR // Кадровые вопросы
  OTHER // Прочее
}

enum TicketStatus {
  PENDING // Ожидание
  IN_PROGRESS // В работе
  RESOLVED // Решено
  REJECTED // Отклонено
  CLOSED // Закрыто
}

enum TicketPriority {
  LOW // Низкая
  MEDIUM // Средняя
  HIGH // Высокая
  URGENT // Срочная
}

model Ticket {
  id String @id @default(cuid())

  // 8-значный публичный ID для отслеживания (10000000-99999999)
  publicId String @unique @db.Char(8)

  // Связь с чатом (если есть)
  chatId String? @unique
  chat   Chat?   @relation("TicketChat", fields: [chatId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)

  // Основная информация
  type     TicketType
  status   TicketStatus   @default(PENDING)
  priority TicketPriority @default(MEDIUM)
  title    String
  content  String         @db.Text // HTML контент с WYSIWYG

  // Файлы, прикрепленные к тикету
  attachments TicketAttachment[]

  // Ответы на тикет (комментарии)
  comments TicketComment[]

  // Журнал действий
  actionLogs TicketActionLog[]

  // Метаданные
  tags       String? // JSON массив тегов для аналитики
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  // Связь с чатом удалена (тикеты больше не используются)
  // chatId String? @unique
  // chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  // Причина отклонения (для Председателя)
  rejectionReason String? @db.Text

  // Рейтинг полезности ответа (1-5, заполняется членом профсоюза)
  helpfulRating        Int?
  helpfulRatingComment String?   @db.Text // Комментарий к оценке
  helpfulRatingAt      DateTime? // Когда была выставлена оценка

  // Организация (для фильтрации обращений Председателем)
  organizationId String?
  organization   Organization? @relation("OrganizationTickets", fields: [organizationId], references: [id], onDelete: SetNull)

  // Отслеживание сроков ответа
  responseDeadline     DateTime? // Дедлайн для ответа председателя (72 часа с момента создания)
  lastResponseAt       DateTime? // Дата последнего ответа председателя
  lastUserResponseAt   DateTime? // Дата последнего ответа пользователя (после ответа председателя)
  userResponseDeadline DateTime? // Дедлайн для ответа пользователя (72 часа после ответа председателя)
  isOverdue            Boolean   @default(false) // Просрочено ли обращение
  overdueReportedAt    DateTime? // Когда последний раз было отправлено уведомление о просрочке
  lastReminderSentAt   DateTime? // Когда последний раз было отправлено напоминание (ежедневно в 9:00 МСК)
  autoClosedAt         DateTime? // Дата автоматического закрытия (если пользователь не ответил в течение 72 часов)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([publicId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([responseDeadline])
  @@index([isOverdue])
  @@index([userResponseDeadline])
}

// Вложения к тикету
model TicketAttachment {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileName String
  filePath String // Путь к файлу в файловой системе
  fileSize Int // Размер в байтах
  mimeType String

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Комментарии к тикету (ответы)
model TicketComment {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserTicketComments", fields: [userId], references: [id], onDelete: Cascade)

  content String @db.Text // HTML контент с WYSIWYG

  // Файлы, прикрепленные к комментарию
  attachments TicketCommentAttachment[]

  isInternal Boolean @default(false) // Внутренний комментарий (виден только админам)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

// Вложения к комментарию
model TicketCommentAttachment {
  id String @id @default(cuid())

  commentId String
  comment   TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  fileSize Int
  mimeType String

  createdAt DateTime @default(now())

  @@index([commentId])
}

// Журнал действий по обращениям (для логирования всех действий Председателя)
model TicketActionLog {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Кто выполнил действие
  userId String
  user   User   @relation("UserTicketActions", fields: [userId], references: [id], onDelete: Cascade)

  // Тип действия
  actionType String // "created", "updated", "replied", "rejected", "approved", "deleted", "message_edited", "status_changed"

  // Описание действия
  description String @db.Text

  // Старое и новое значение (для отслеживания изменений)
  oldValue String? @db.Text
  newValue String? @db.Text

  // Метаданные (JSON)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
}

// Push Notifications (Firebase Cloud Messaging)
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Firebase Cloud Messaging token
  fcmToken       String? @unique // FCM registration token (nullable for legacy records)
  subscriptionId String? // Legacy field (kept for compatibility)

  // Legacy OneSignal fields (deprecated, will be removed)
  oneSignalId String? // Deprecated: OneSignal Player ID

  lastSyncAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([fcmToken])
  @@index([oneSignalId]) // Legacy index
}

model DiscountPreference {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushEnabled Boolean @default(false)
  filters     Json?
  geolocation Json?

  lastNotificationAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pushEnabled])
}

// Локальное хранилище скидок (синхронизация с BestBenefits)
model Discount {
  id               Int     @id // ID из BestBenefits (не автоинкремент)
  title            String // Название скидки
  description      String? @db.Text // Полное описание (очищенное от HTML-мусора)
  shortDescription String? @db.Text // Краткое описание
  discountValue    String? // Размер скидки (например "10%", "500₽")

  // Изображение (хранится локально на CDN)
  imageUrl         String? @db.Text // URL на CDN (вместо base64)
  originalImageUrl String? @db.Text // Оригинальный URL/base64 для сверки

  // Ссылки
  partnerUrl String? @db.Text // Ссылка на партнера

  // Категории и города (JSON массивы для простоты)
  categories       Json? // [{id, name, order}]
  mainCategoryId   Int? // ID главной категории
  mainCategoryName String? // Название главной категории
  cities           Json? // [{id, name}]
  tags             Json? // ["tag1", "tag2"]
  options          Json? // [{id, name}] - варианты скидки (например Яндекс Лавка)

  // Дополнительные поля
  isPremium  Boolean   @default(false)
  validUntil DateTime? // Срок действия скидки

  // Синхронизация
  bbUpdatedAt  DateTime? // Дата обновления в BestBenefits
  lastSyncedAt DateTime  @default(now()) // Когда синхронизировали
  isActive     Boolean   @default(true) // Активна ли скидка

  // Связи
  favorites DiscountFavorite[] @relation("DiscountFavorites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mainCategoryId])
  @@index([isActive])
  @@index([validUntil])
  @@index([lastSyncedAt])
}

// Категории скидок (синхронизация с BestBenefits)
model DiscountCategory {
  id            Int     @id // ID из BestBenefits
  name          String // Название категории
  order         Int     @default(0) // Порядок сортировки
  iconName      String? // Название иконки (опционально)
  discountCount Int     @default(0) // Количество скидок в категории

  lastSyncedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Избранные скидки пользователя
model DiscountFavorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("DiscountFavorites", fields: [userId], references: [id], onDelete: Cascade)
  discountId Int
  discount   Discount @relation("DiscountFavorites", fields: [discountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, discountId])
  @@index([userId])
  @@index([discountId])
}

// Активированные скидки пользователя с промокодами и сроками действия
model DiscountActivation {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("DiscountActivations", fields: [userId], references: [id], onDelete: Cascade)
  discountId   Int // ID скидки из BestBenefits (связь добавим позже после синхронизации)
  promoCode    String? // Промокод (сохраняем локально, даже если BestBenefits очистит)
  activatedAt  DateTime  @default(now()) // Дата активации
  validUntil   DateTime? // Срок действия скидки (из BestBenefits API)
  syncedFromBB Boolean   @default(false) // Синхронизировано ли из BestBenefits
  lastSyncedAt DateTime? // Когда последний раз синхронизировали с BestBenefits

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, discountId])
  @@index([userId])
  @@index([discountId])
  @@index([validUntil])
}

// Уведомления пользователя (история всех уведомлений)
model UserNotification {
  id String @id @default(cuid())

  // Пользователь-получатель
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Тип уведомления
  type String // "chat_message", "news_published", "post_comment", "ticket_response", etc.

  // Содержимое уведомления
  title String
  body  String @db.Text

  // URL для перехода при клике
  url String?

  // Метаданные (JSON) - может содержать дополнительные данные (senderId, newsId, ticketId, etc.)
  metadata Json?

  // Прочитано ли уведомление
  readAt DateTime?

  // Отправлено ли через push/email
  pushSent  Boolean @default(false)
  emailSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}

// Логирование системных ошибок и событий
enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SystemLog {
  id String @id @default(cuid())

  level      LogLevel @default(INFO)
  source     String // API endpoint, component name, etc
  message    String
  details    Json?
  stackTrace String?

  // Связь с пользователем (если ошибка произошла в контексте пользователя)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Метаданные для анализа
  metadata Json?

  // Статус разрешения ошибки
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedByUser User?     @relation("ResolvedLogs", fields: [resolvedBy], references: [id], onDelete: SetNull)

  // Уведомление отправлено?
  notificationSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([source])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId])
}

// Новости
// Каналы публикации новостей
model NewsChannel {
  id String @id @default(cuid())

  // Название канала
  name String

  // Описание канала
  description String? @db.Text

  // Иконка канала (URL или base64)
  iconUrl String? @db.Text

  // Организация, которой принадлежит канал
  organizationId String?
  organization   Organization? @relation("OrganizationNewsChannels", fields: [organizationId], references: [id], onDelete: Cascade)

  // Создатель канала
  createdById String
  createdBy   User   @relation("NewsChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)

  // Является ли канал основным (по умолчанию для организации)
  isMain Boolean @default(false)

  // Новости в канале
  newsPosts NewsPost[]

  // Связанный чат (для отображения в UI чата)
  chat Chat? @relation("ChatNewsChannel")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@index([isMain])
}

model NewsPost {
  id String @id @default(cuid())

  // Автор (супер-админ или Председатель)
  authorId String
  author   User   @relation("NewsPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Канал публикации
  channelId String?
  channel   NewsChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  // Основная информация
  title      String
  content    String  @db.Text // HTML контент с WYSIWYG
  coverImage String? @db.Text // Data URL изображения (base64) или внешний URL

  // Опубликовано ли
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Статистика
  viewCount Int @default(0)

  // Связи
  likes    NewsLike[]
  views    NewsView[]
  comments NewsComment[]
  polls    NewsPoll[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([channelId])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([createdAt])
}

// Лайки новостей
model NewsLike {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([newsPostId, userId])
  @@index([newsPostId])
  @@index([userId])
}

// Просмотры новостей (отслеживание уникальных просмотров)
model NewsView {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsViewUser", fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([newsPostId, userId])
  @@index([newsPostId])
  @@index([userId])
  @@index([viewedAt])
}

// История членства в профсоюзе
model MembershipHistory {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Организация, в которой состоял на учете
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationName String? // Название организации (для истории, если организация удалена)

  // Статус в этой организации
  status String // ACCEPTED (принят на учет), REMOVED (снят с учета), TRANSFERRED (переведен)

  // Даты
  statusDate DateTime // Дата изменения статуса
  notes      String?  @db.Text // Дополнительные заметки

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([statusDate])
}

// Комментарии к новостям
model NewsComment {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsCommentUser", fields: [userId], references: [id], onDelete: Cascade)

  // Ответ на другой комментарий (для вложенных комментариев)
  parentId String?
  parent   NewsComment?  @relation("NewsCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  NewsComment[] @relation("NewsCommentReplies")

  content String @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsPostId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

// Опросы в новостях
model NewsPoll {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  question String
  options  Json // Массив вариантов ответов: [{id: string, text: string}]

  // Завершен ли опрос
  isClosed Boolean   @default(false)
  closesAt DateTime?

  // Голоса
  votes NewsPollVote[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsPostId])
  @@index([isClosed])
}

// Голоса в опросах
model NewsPollVote {
  id String @id @default(cuid())

  pollId String
  poll   NewsPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsPollVoteUser", fields: [userId], references: [id], onDelete: Cascade)

  optionId String // ID выбранного варианта ответа

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

// Справочник должностей
model JobTitle {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Справочник профессий
model Profession {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Подписки пользователей друг на друга (для уведомлений о готовности чата)
model UserSubscription {
  id String @id @default(cuid())

  // Подписчик (кто подписывается)
  subscriberId String
  subscriber   User   @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)

  // На кого подписан
  targetUserId String
  targetUser   User   @relation("UserSubscribers", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Настройки уведомлений
  emailNotifications Boolean @default(true) // Email уведомления
  pushNotifications  Boolean @default(true) // Push уведомления

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriberId, targetUserId])
  @@index([subscriberId])
  @@index([targetUserId])
  @@index([createdAt])
}

// Тип чата
enum ChatType {
  PRIVATE // Личный чат между двумя пользователями
  GROUP // Групповой чат
  CHANNEL // Канал (как в Slack): только председатель создает посты, участники комментируют в тредах
}

// Чаты между пользователями
model Chat {
  id String @id @default(cuid())

  // Тип чата
  type ChatType @default(PRIVATE)

  // Для групповых чатов
  name        String? // Название группы
  description String? @db.Text // Описание группы
  iconUrl     String? @db.Text // Иконка группы
  isPublic    Boolean @default(true) // Публичный или закрытый (для групповых чатов)
  createdById String? // Создатель группы
  createdBy   User?   @relation("ChatCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Участники чата (используется для всех типов чатов)
  participants ChatParticipant[]

  // Последнее сообщение (для сортировки)
  lastMessageId String?      @unique
  lastMessage   ChatMessage? @relation("ChatLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime?

  // Все сообщения чата
  messages ChatMessage[] @relation("ChatMessages")

  // Обращения (тикеты) связанные с чатом
  ticket Ticket? @relation("TicketChat")

  // Заседание (групповой чат участников заседания для согласования и обсуждения)
  meetingId String?  @unique
  meeting   Meeting? @relation("MeetingGroupChat", fields: [meetingId], references: [id], onDelete: SetNull)

  // Канал новостей (для CHANNEL типа чата)
  newsChannelId String?      @unique
  newsChannel   NewsChannel? @relation("ChatNewsChannel", fields: [newsChannelId], references: [id], onDelete: SetNull)

  // Архивирован ли чат
  archivedAt DateTime?

  // Папки, в которых находится этот чат
  folders ChatFolderChat[] @relation("ChatFolders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([type])
  @@index([lastMessageAt])
  @@index([meetingId])
}

// Участники группового чата
model ChatParticipant {
  id String @id @default(cuid())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  userId String?
  user   User?  @relation("ChatParticipants", fields: [userId], references: [id], onDelete: SetNull)

  // Плейсхолдер для удалённого пользователя: при удалении User в этом поле сохраняем "Удалённый пользователь"
  deletedUserDisplayName String? @db.Text

  // Роль в группе
  role String @default("member") // "admin", "member"

  // Приглашен кем
  invitedById String?
  invitedBy   User?   @relation("ChatInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  // Прочитано ли последнее сообщение
  readAt DateTime?

  // Очищена история чата (сообщения до этой даты скрыты для пользователя)
  clearedAt DateTime?

  // Timestamps
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@index([role])
  @@index([chatId, leftAt]) // ОПТИМИЗАЦИЯ: Для быстрой фильтрации активных участников
  @@index([userId, leftAt]) // ОПТИМИЗАЦИЯ: Для быстрого поиска чатов пользователя
}

// Сообщения чатов
model ChatMessage {
  id          String @id @default(cuid())
  chatId      String
  chat        Chat   @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User   @relation("ChatMessageSender", fields: [senderId], references: [id])
  content     String @db.Text
  messageType String @default("text") // text, image, file, video, audio

  // Для ответов (reply to message)
  replyToId String?
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  // Треды (threads) - корневое сообщение треда
  threadRootId  String?       @unique // Если это корневое сообщение треда, то null. Иначе - ID корневого сообщения
  threadRoot    ChatMessage?  @relation("ThreadRoot", fields: [threadRootId], references: [id], onDelete: Cascade)
  threadReplies ChatMessage[] @relation("ThreadRoot") // Ответы в треде (только для корневого сообщения)

  // Редактирование
  editedAt DateTime?

  // Вложения
  attachments ChatMessageAttachment[]

  // Реакции
  reactions ChatMessageReaction[]

  // Прочитано кем
  readBy ChatMessageRead[]

  // Метрики треда (только для корневого сообщения)
  threadRepliesCount Int       @default(0) // Количество ответов в треде
  threadLastReplyAt  DateTime? // Время последнего ответа в треде

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Обратная связь для lastMessage в Chat
  chatAsLastMessage Chat? @relation("ChatLastMessage")

  @@index([chatId, createdAt])
  @@index([chatId, threadRootId, createdAt]) // Для загрузки тредов
  @@index([senderId])
  @@index([replyToId])
  @@index([threadRootId])
  @@index([chatId, senderId, createdAt]) // ОПТИМИЗАЦИЯ: Для подсчета непрочитанных сообщений
}

model ChatMessageAttachment {
  id           String      @id @default(cuid())
  messageId    String
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type         String // image, file, video, audio
  url          String
  name         String
  size         Int?
  mimeType     String?
  thumbnailUrl String?
  width        Int?
  height       Int?

  createdAt DateTime @default(now())

  @@index([messageId])
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatMessageReactions", fields: [userId], references: [id])
  emoji     String // 🎉, 👍, ❤️ и т.д.

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatMessageReads", fields: [userId], references: [id])

  readAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

// Посты пользователей (стена)
model UserPost {
  id String @id @default(cuid())

  // Автор поста
  authorId String
  author   User   @relation("UserPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Контент поста
  content String @db.Text

  // Тип поста
  postType String @default("text") // "text", "image", "link", "video", "file"

  // Вложения
  attachments PostAttachment[]

  // Метаданные для ссылок и видео
  linkMetadata  Json? // {url, title, description, image, siteName} для ссылок
  videoMetadata Json? // {provider: "youtube"|"rutube"|"vk", videoId, embedUrl} для видео

  // Обложка для статей
  coverImage String? @db.Text // URL изображения обложки для статей

  // Статистика
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  viewCount     Int @default(0)

  // Связи
  likes    PostLike[]
  views    PostView[]
  comments PostComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([postType])
}

// Вложения к постам
model PostAttachment {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Тип вложения
  type String // "image", "file", "video"

  // Файл
  fileName     String
  originalName String
  filePath     String  @db.Text
  fileSize     Int
  mimeType     String?

  // Превью для изображений и файлов
  thumbnailPath String? @db.Text

  createdAt DateTime @default(now())

  @@index([postId])
}

// Лайки постов
model PostLike {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// Просмотры постов (отслеживание уникальных просмотров)
model PostView {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PostViewUser", fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([viewedAt])
}

// Комментарии к постам
model PostComment {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PostCommentUser", fields: [userId], references: [id], onDelete: Cascade)

  // Ответ на другой комментарий (для вложенных комментариев)
  parentId String?
  parent   PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PostComment[] @relation("PostCommentReplies")

  content String @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

// Логирование синхронизаций (cron jobs)
model SyncLog {
  id String @id @default(cuid())

  type   String // Тип синхронизации: DISCOUNTS, USERS, etc.
  source String // Источник: CRON, MANUAL, API
  status String // SUCCESS, PARTIAL, FAILED

  itemsCreated Int @default(0)
  itemsUpdated Int @default(0)
  itemsFailed  Int @default(0)

  duration Int // Время выполнения в миллисекундах
  errors   Json? // Массив ошибок (если есть)
  metadata Json? // Дополнительные данные

  createdAt DateTime @default(now())

  @@index([type])
  @@index([source])
  @@index([status])
  @@index([createdAt])
}

// Роли сотрудников организации (Заместитель, Бухгалтер, Секретарь и т.д.)
model StaffRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrganizationStaffRoles", fields: [organizationId], references: [id], onDelete: Cascade)

  // Название роли (должность)
  name        String // "Заместитель председателя", "Бухгалтер", "Секретарь", etc.
  description String? @db.Text // Описание роли

  // Права доступа (JSON объект с чекбоксами)
  // Пример: { "documents": true, "discounts": true, "members_view": true, "members_edit": false, "appeals": true, "chats": true, "news": true, "reports": false }
  permissions Json

  // Системная роль (предустановленная, нельзя удалить)
  isSystem Boolean @default(false)

  // Активна ли роль
  isActive Boolean @default(true)

  // Роль в выборном органе (Председатель ППО, Зам. председателя, Член профкома) — для состава заседаний
  isElectedBody Boolean @default(false)

  // Управленец профкома (председатель, зам.) — для полей «Докладывает»/«Со-докладчик»; не «Член Профкома»
  isManagement Boolean @default(false)

  // Сотрудники с этой ролью
  staff OrganizationStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name]) // Уникальное название роли в рамках организации
  @@index([organizationId])
  @@index([isActive])
}

// Сотрудники организации (связь пользователь-организация-роль)
model OrganizationStaff {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation("UserStaffPositions", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation("OrganizationStaffMembers", fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           StaffRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Статус сотрудника
  status StaffStatus @default(PENDING)

  // Приглашение
  inviteToken   String?   @unique // Токен для принятия приглашения
  inviteExpires DateTime? // Срок действия токена
  invitedAt     DateTime  @default(now())
  acceptedAt    DateTime? // Когда принял приглашение

  // Временный пароль (для первого входа)
  tempPassword String? // Хеш временного пароля

  // Заметки (например, причина деактивации)
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId]) // Один пользователь может быть сотрудником организации только один раз
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([inviteToken])
}

// Приглашения сотрудников (для отслеживания истории)
model StaffInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrganizationStaffInvitations", fields: [organizationId], references: [id], onDelete: Cascade)

  // Кого приглашаем
  email String // Email приглашаемого
  phone String? // Телефон приглашаемого (опционально)

  // Роль которую назначаем
  roleId String

  // Токен приглашения
  token     String   @unique
  expiresAt DateTime

  // Статус
  status String @default("pending") // "pending", "accepted", "expired", "cancelled"

  // Результат
  acceptedByUserId String? // ID пользователя который принял приглашение
  acceptedAt       DateTime?

  // Кто отправил приглашение
  invitedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([token])
  @@index([email])
  @@index([status])
}

// ==========================================
// СИСТЕМА ОТЧЁТНОСТИ ПРОФСОЮЗОВ
// ==========================================

// Шаблон отчёта (Форма 2, Форма 7 и т.д.)
model ReportTemplate {
  id          String            @id @default(cuid())
  code        String            @unique // "form2", "form7" и т.д.
  name        String // "Статистическая отчётность ППО"
  description String?           @db.Text
  periodicity ReportPeriodicity @default(ANNUAL)

  // Для каких типов организаций доступен
  forOrganizationTypes Json? // ["PRIMARY", "LOCAL", "REGIONAL"]

  // Секции шаблона
  sections ReportTemplateSection[]

  // Отчёты созданные по этому шаблону
  reports Report[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

// Секция шаблона отчёта (I. Общие сведения, II. Профсоюзное членство)
model ReportTemplateSection {
  id         String         @id @default(cuid())
  templateId String
  template   ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  code  String // "section1", "section2"
  title String // "I. Общие сведения"
  order Int    @default(0) // Порядок отображения

  // Поля в секции
  fields ReportTemplateField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, code])
  @@index([templateId])
  @@index([order])
}

// Поле шаблона отчёта
model ReportTemplateField {
  id        String                @id @default(cuid())
  sectionId String
  section   ReportTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  code        String // "f2_form1_title", "f2_form2_field1"
  name        String // Системное имя поля
  title       String // "Наименование профсоюза"
  num         String? // "1", "1.1", "2" (номер строки)
  description String? @db.Text // Подсказка к полю
  help        String? // Краткая справка

  // Тип поля
  fieldType String @default("string") // "string", "integer", "decimal", "date", "select", "multiselect", "text"

  // Настройки
  isRequired    Boolean @default(false)
  isMultiple    Boolean @default(false) // Несколько столбцов (начало года, конец года, женщины)
  columnsCount  Int     @default(1) // Количество столбцов для ввода
  columnHeaders Json? // ["На начало года", "На конец года", "Из них женщины"]

  // Для select/multiselect
  options Json? // [{value: "1", label: "Да"}, {value: "0", label: "Нет"}]

  // Валидация
  minValue Int? // Минимальное значение (для integer)
  maxValue Int? // Максимальное значение
  pattern  String? // Regex для валидации

  // Автозаполнение из профиля организации
  autoFillFrom String? // "organization.name", "organization.chairman", etc.

  // Формула для автоматического расчёта
  formula String? // "f2_form2_field7 + f2_form2_field8" - сумма других полей

  order Int @default(0) // Порядок отображения

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, code])
  @@index([sectionId])
  @@index([order])
}

// Отчёт (заполненный экземпляр шаблона)
model Report {
  id             String         @id @default(cuid())
  templateId     String
  template       ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization   @relation("OrganizationReports", fields: [organizationId], references: [id], onDelete: Cascade)

  // Период отчёта
  periodYear  Int // 2024, 2025
  periodMonth Int? // 1-12 (для месячных/квартальных)

  // Статус и workflow
  status ReportStatus @default(DRAFT)

  // Данные отчёта (JSON с заполненными полями)
  // Формат: { "f2_form1_title": "Название", "f2_form2_field1": [100, 120, 50], ... }
  data Json?

  // История изменений статуса
  statusHistory ReportStatusHistory[]

  // Подчинённые отчёты (от дочерних организаций)
  childReports   Report[] @relation("ReportHierarchy")
  parentReport   Report?  @relation("ReportHierarchy", fields: [parentReportId], references: [id], onDelete: SetNull)
  parentReportId String?

  // Причина отклонения (revision)
  revisionReason String? @db.Text

  // Кто заполнил и когда отправил
  filledByUserId String?
  submittedAt    DateTime?

  // Кто согласовал/утвердил
  approvedByUserId  String?
  approvedAt        DateTime?
  confirmedByUserId String?
  confirmedAt       DateTime?

  // Срок сдачи
  deadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, organizationId, periodYear, periodMonth])
  @@index([templateId])
  @@index([organizationId])
  @@index([status])
  @@index([periodYear])
  @@index([deadline])
}

// История изменения статуса отчёта
model ReportStatusHistory {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  fromStatus ReportStatus?
  toStatus   ReportStatus

  // Кто изменил
  changedByUserId String

  // Комментарий (например, причина отклонения)
  comment String? @db.Text

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([createdAt])
}

// ============================================================================
// ПАПКИ ДЛЯ ЧАТОВ
// ============================================================================

// Папка для группировки чатов (для председателей и сотрудников)
model ChatFolder {
  id   String @id @default(cuid())
  name String // Название папки

  // Организация, к которой привязана папка (опционально)
  organizationId String?
  organization   Organization? @relation("OrganizationChatFolders", fields: [organizationId], references: [id], onDelete: Cascade)

  // Кто создал папку
  createdById String
  createdBy   User   @relation("UserChatFolders", fields: [createdById], references: [id], onDelete: Cascade)

  // Иконка папки (emoji или цвет)
  icon  String? // Emoji: 📁, 📂, 🗂️, 📋, 💼
  color String? // HEX цвет: #FF5733

  // Порядок отображения
  order Int @default(0)

  // Чаты в папке
  chats ChatFolderChat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@index([order])
}

// Связь чата с папкой (many-to-many через промежуточную таблицу)
model ChatFolderChat {
  id String @id @default(cuid())

  folderId String
  folder   ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  chatId String
  chat   Chat @relation("ChatFolders", fields: [chatId], references: [id], onDelete: Cascade)

  // Порядок чата внутри папки
  order Int @default(0)

  createdAt DateTime @default(now())

  @@unique([folderId, chatId])
  @@index([folderId])
  @@index([chatId])
}
