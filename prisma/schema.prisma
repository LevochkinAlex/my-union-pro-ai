generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Роли пользователей
enum UserRole {
  MEMBER // Обычный член профсоюза
  PENDING_MEMBER // Ожидает одобрения
  PPO_HEAD // Председатель ППО
  REGIONAL_CHAIRMAN // Председатель регионального отделения
  FEDERAL_CHAIRMAN // Председатель федерации
  SUPER_ADMIN // Суперадмин
}

// Статусы членства
enum MembershipStatus {
  PENDING_VERIFICATION // Ожидает проверки email
  PROFILE_INCOMPLETE // Email подтвержден, профиль не заполнен
  DOCUMENTS_PENDING // Документы отправлены на проверку
  APPROVED // Одобрен как член профсоюза
  REJECTED // Отклонен
  SUSPENDED // Приостановлен
  EXCLUDED // Исключён из профсоюза
}

// Типы организаций
enum OrganizationType {
  PRIMARY // Первичная профсоюзная организация (ППО)
  LOCAL // Местная организация
  REGIONAL // Региональное отделение
  FEDERAL // Федерация
}

// Статус сотрудника организации
enum StaffStatus {
  PENDING // Приглашение отправлено
  ACTIVE // Принято, активен
  INACTIVE // Деактивирован
}

// Статус отчёта
enum ReportStatus {
  DRAFT // Черновик
  SUBMITTED // Отправлен на согласование
  REVISION // На доработке (отклонён)
  APPROVED // Согласован вышестоящей организацией
  CONFIRMED // Утверждён (финальный статус)
}

// Периодичность отчёта
enum ReportPeriodicity {
  MONTHLY // Ежемесячный
  QUARTERLY // Квартальный
  SEMI_ANNUAL // Полугодовой
  ANNUAL // Годовой
}

// Пользователь
model User {
  id               String           @id @default(cuid())
  email            String?          @unique // Email теперь опционален (может быть заполнен позже)
  password         String? // Пароль опционален (SMS-авторизация)
  role             UserRole         @default(PENDING_MEMBER)
  membershipStatus MembershipStatus @default(PENDING_VERIFICATION)

  // Двойная роль: Член профсоюза + Руководитель организации
  // Первичная профсоюзная организация (ППО)
  isPPOHead             Boolean       @default(false) // Флаг что пользователь является председателем ППО
  ppoHeadOrganizationId String?       @unique // ID ППО где пользователь является председателем
  ppoHeadOrganization   Organization? @relation("PPOHeadOrganization", fields: [ppoHeadOrganizationId], references: [id])

  // Местная организация (МПО)
  isMPOHead             Boolean       @default(false) // Флаг что пользователь является председателем МПО
  mpoHeadOrganizationId String?       @unique // ID МПО где пользователь является председателем
  mpoHeadOrganization   Organization? @relation("MPOHeadOrganization", fields: [mpoHeadOrganizationId], references: [id])

  // Региональная организация (РПО)
  isRPOHead             Boolean       @default(false) // Флаг что пользователь является председателем РПО
  rpoHeadOrganizationId String?       @unique // ID РПО где пользователь является председателем
  rpoHeadOrganization   Organization? @relation("RPOHeadOrganization", fields: [rpoHeadOrganizationId], references: [id])

  // Текущий режим просмотра: MEMBER, PPO_HEAD, MPO_HEAD, RPO_HEAD
  viewMode String @default("MEMBER")

  // Персональные данные
  firstName   String?
  lastName    String?
  middleName  String?
  dateOfBirth DateTime?
  phone       String?   @unique // Текущий телефон профиля (может быть изменён)
  authPhone   String?   @unique // Телефон, через который была первая авторизация (НЕ меняется)
  address     String?

  // История телефонов
  phoneHistory PhoneHistory[]
  avatarUrl    String?        @db.Text // URL фотографии профиля (base64 data URL может быть очень длинным)

  // Telegram интеграция для 2FA
  telegramChatId   String? @unique // Chat ID пользователя в Telegram для отправки PIN-кодов
  telegramUsername String? // Username пользователя в Telegram (для справки)

  // MAX Messenger интеграция для 2FA
  maxChatId   String? @unique // Chat ID пользователя в MAX для отправки PIN-кодов
  maxUsername String? // Username пользователя в MAX (для справки)

  // Яндекс ID интеграция
  yandexId String? @unique // Yandex ID пользователя для связи аккаунтов

  // Предпочтения для скидок
  preferredDiscountCity String? // Предпочтительный город для фильтра скидок (название города)

  // Профессиональная информация
  jobTitle   String? // Занимаемая должность
  profession String? // Основная профессия (перемещена в дополнительную информацию)
  education  String? // Образование (перемещено в дополнительную информацию)

  // Место работы (обязательное для заявлений)
  workplace        String? // Название компании места работы
  workplaceInn     String? // ИНН компании места работы
  directorName     String? // ФИО руководителя компании (из ФНС через Dadata)
  directorPosition String? // Должность руководителя компании (из ФНС через Dadata)

  // Дополнительная информация профиля
  employmentStatus   String? // Занятость: WORK (работа), STUDY (учеба), RETIREMENT (пенсия)
  hobbies            String?  @db.Text // Хобби и увлечения
  aboutMe            String?  @db.Text // О себе
  hasChildren        Boolean? // Есть ли дети
  childrenInfo       String?  @db.Text // Информация о детях
  childrenBirthDates String?  @db.Text // Даты рождения детей в формате JSON: [{"name": "Имя", "birthDate": "YYYY-MM-DD", "gender": "М"|"Ж"}] для подарков
  maritalStatus      String? // Семейное положение (холост/замужем/женат/в разводе)
  spouseInfo         String?  @db.Text // Информация о супруге/супруге
  awards             String?  @db.Text // Награды в формате JSON: [{"type": "ведомственная"|"государственная"|"профсоюзная", "year": "YYYY", "description": "описание"}] 
  training           String?  @db.Text // Обучение в формате JSON: [{"name": "название", "year": "YYYY", "description": "описание"}]
  professions        String?  @db.Text // Профессии в формате JSON: [{"name": "название профессии", "experience": "опыт работы"}]
  educations         String?  @db.Text // Образование в формате JSON: [{"level": "уровень", "institution": "учебное заведение", "year": "год окончания", "specialty": "специальность"}]
  additionalInfo     String?  @db.Text // Дополнительная информация (свободный текст)

  // База знаний о пользователе (для ИИ)
  userKnowledgeBase UserKnowledgeBase? @relation("UserKnowledgeBase")

  // Подпись (путь к файлу на сервере)
  signaturePath String?

  // Флаг изменения профиля после генерации документов
  profileChangedAfterDocuments Boolean   @default(false)
  profileLastModified          DateTime? // Дата последнего изменения профиля

  // Организация
  organizationId   String?
  organizationName String? // Название организации (если она не в базе МойСоюз, но найдена в Минюсте)
  organization     Organization? @relation(fields: [organizationId], references: [id])

  // Блокировка по лимиту подписки: если задано — доступ закрыт (последние зарегистрированные сверх лимита тарифа)
  subscriptionBlockedAt DateTime?

  // Документы пользователя
  documents Document[]

  // Документооборот: назначенные документы
  assignedDocuments Document[] @relation("DocumentAssignedTo")
  approvedDocuments Document[] @relation("DocumentApprovedBy")
  signedDocuments   Document[] @relation("DocumentSignedBy")

  // История изменений статусов документов
  documentStatusChanges DocumentStatusHistory[] @relation("DocumentStatusChangedBy")

  // Согласования документов
  documentApprovals DocumentApproval[] @relation("DocumentApprovalUser")

  // Email верификация
  emailVerified       DateTime?
  verificationToken   String?   @unique
  verificationExpires DateTime?

  // Сброс пароля
  resetToken        String?   @unique
  resetTokenExpires DateTime?

  updatedSettings            SystemSetting[]     @relation("SystemSettingUpdatedBy")
  uploadedKnowledgeDocuments KnowledgeDocument[] @relation("KnowledgeDocumentUploadedBy")
  createdDocumentTemplates   DocumentTemplate[]  @relation("DocumentTemplateCreatedBy")
  updatedDocumentTemplates   DocumentTemplate[]  @relation("DocumentTemplateUpdatedBy")

  // Тикеты (обращения)
  tickets        Ticket[]          @relation("UserTickets")
  ticketComments TicketComment[]   @relation("UserTicketComments")
  ticketActions  TicketActionLog[] @relation("UserTicketActions")

  // Push Notifications
  pushSubscriptions   PushSubscription[]
  discountPreference  DiscountPreference?
  discountActivations DiscountActivation[] @relation("DiscountActivations")
  discountFavorites   DiscountFavorite[]   @relation("DiscountFavorites")

  // Уведомления (история)
  notifications UserNotification[]

  // BestBenefits Integration
  bestBenefitsUserId    String?   @unique // ID пользователя в системе BestBenefits
  bestBenefitsStatus    String? // Статус в BestBenefits (active, blocked и т.д.)
  bestBenefitsCreatedAt DateTime? // Дата создания в BestBenefits
  bestBenefitsPassword  String? // Пароль для BestBenefits (зашифрован AES-256-GCM)

  // Профсоюзное членство
  unionCardNumber           String?   @unique // Номер профсоюзной карточки (16-значный код формата XXXX XXXX XXXX XXXX)
  membershipJoinedAt        DateTime? // Дата вступления в профсоюз (если принят вышестоящим органом)
  membershipExcludedAt      DateTime? // Дата исключения из профсоюза
  membershipExclusionReason String?   @db.Text // Причина исключения
  unionMembershipStatus     String?   @default("NOT_ACCEPTED") // Статус членства: ACCEPTED (принят на учет), NOT_ACCEPTED (не принят), REMOVED (снят с учета)
  isExistingMember          Boolean   @default(false) // Уже действующий член (документы на бумаге у председателя)

  // История членства
  membershipHistory MembershipHistory[]

  // Настройки уведомлений
  pushNotificationsEnabled Boolean @default(true) // Включены ли push уведомления
  pushSoundEnabled         Boolean @default(true) // Включен ли звук в push уведомлениях
  emailBotNotifications    Boolean @default(false) // Email уведомления от бота (по умолчанию выключено)
  emailAppealNotifications Boolean @default(true) // Email уведомления по обращениям (по умолчанию включено)

  // System Logs
  systemLogs   SystemLog[]
  resolvedLogs SystemLog[] @relation("ResolvedLogs")

  // Новости
  newsPosts     NewsPost[]     @relation("NewsPostAuthor")
  newsChannels  NewsChannel[]  @relation("NewsChannelCreator")
  newsLikes     NewsLike[]     @relation("NewsLikeUser")
  newsViews     NewsView[]     @relation("NewsViewUser")
  newsComments  NewsComment[]  @relation("NewsCommentUser")
  newsPollVotes NewsPollVote[] @relation("NewsPollVoteUser")

  // Подписки (на кого подписан)
  subscriptions UserSubscription[] @relation("UserSubscriptions")
  // Подписчики (кто подписан на этого пользователя)
  subscribers   UserSubscription[] @relation("UserSubscribers")

  // Созданные групповые чаты
  createdChats     Chat[]                @relation("ChatCreator")
  // Участник чатов
  chatParticipants ChatParticipant[]     @relation("ChatParticipants")
  // Приглашенные в чаты
  invitedToChats   ChatParticipant[]     @relation("ChatInviter")
  // Сообщения в чатах
  chatMessages     ChatMessage[]         @relation("ChatMessageSender")
  // Реакции на сообщения
  messageReactions ChatMessageReaction[] @relation("ChatMessageReactions")
  // Прочитанные сообщения
  messageReads     ChatMessageRead[]     @relation("ChatMessageReads")
  // Созданные папки для чатов
  chatFolders      ChatFolder[]          @relation("UserChatFolders")

  // Посты пользователя
  posts        UserPost[]    @relation("UserPostAuthor")
  postLikes    PostLike[]    @relation("PostLikeUser")
  postViews    PostView[]    @relation("PostViewUser")
  postComments PostComment[] @relation("PostCommentUser")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SMS PIN-коды для авторизации
  smsPinCodes SMSPinCode[]

  // Временные токены для авторизации через соцсети
  loginTokens LoginToken[]

  // Email PIN-коды для валидации email
  emailPinCodes EmailPinCode[] @relation("EmailPinCodes")

  // Сотрудник организации (роли: Заместитель, Бухгалтер и т.д.)
  staffPositions OrganizationStaff[] @relation("UserStaffPositions")

  // Заседания профкома
  createdMeetings       Meeting[]            @relation("MeetingCreatedBy")
  meetingParticipations MeetingParticipant[] @relation("UserMeetingParticipations")
  agendaItemsSpeaker    MeetingAgendaItem[]  @relation("AgendaItemSpeaker")
  agendaItemsCoSpeaker MeetingAgendaItem[]  @relation("AgendaItemCoSpeaker")
  agendaVotes           MeetingAgendaVote[]  @relation("UserAgendaVotes")

  @@index([email])
  @@index([phone])
  @@index([organizationId])
  @@index([verificationToken])
  @@index([resetToken])
  @@index([unionCardNumber])
  @@index([unionMembershipStatus])
  @@index([createdAt]) // Для сортировки по дате создания
  @@index([role]) // Для фильтрации по роли
  // Составные индексы для оптимизации поиска
  @@index([firstName, lastName, middleName]) // Для поиска по ФИО
  @@index([organizationId, createdAt]) // Для фильтрации по организации с сортировкой
}

// SMS PIN-коды для авторизации
model SMSPinCode {
  id String @id @default(cuid())

  // Номер телефона (может быть не привязан к пользователю, если это первая авторизация)
  phone String

  // PIN-код (захеширован)
  hashedPin String

  // Пользователь (если найден по телефону)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Время истечения (5 минут)
  expiresAt DateTime

  // Использован ли код
  used   Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([userId])
  @@index([expiresAt])
  @@index([used])
}

// История телефонов пользователя
model PhoneHistory {
  id String @id @default(cuid())

  // Пользователь
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Телефон (нормализован: +7XXXXXXXXXX)
  phone           String
  phoneNormalized String // Только цифры без +

  // Тип изменения
  changeType String // AUTH (авторизация), PROFILE_UPDATE (обновление профиля), MERGE (слияние аккаунтов)

  // Предыдущий телефон (если это смена)
  previousPhone String?

  // Источник изменения
  source String? // "telegram", "sms", "profile", "admin"

  // IP адрес при изменении (для безопасности)
  ipAddress String?

  // Заметки (например, причина изменения)
  notes String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([createdAt])
}

// Временные токены для авторизации через соцсети (Telegram, VK, Google и т.д.)
model LoginToken {
  id String @id @default(cuid())

  // Токен (уникальный, случайный)
  token String @unique

  // Пользователь
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Время истечения (5 минут)
  expiresAt DateTime

  // Использован ли токен
  used   Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([used])
}

// Email PIN-коды для валидации email
model EmailPinCode {
  id String @id @default(cuid())

  // Email адрес
  email String

  // PIN-код (захеширован)
  hashedPin String

  // Пользователь (если найден по email)
  userId String?
  user   User?   @relation("EmailPinCodes", fields: [userId], references: [id], onDelete: Cascade)

  // Время истечения (10 минут)
  expiresAt DateTime

  // Использован ли код
  used   Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
  @@index([used])
}

// Организация (ППО, региональные, федерация)
model Organization {
  id   String           @id @default(cuid())
  name String
  type OrganizationType

  // Иерархия
  parentId String?
  parent   Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrganizationHierarchy")

  // Уровень в иерархии (0 = корень, 1 = дочерняя организация первого уровня и т.д.)
  level Int @default(0)

  // Порядок сортировки (для отображения в списке)
  sortOrder Int @default(0)

  // Полный путь в иерархии (для быстрого поиска, например: "Федерация / Региональная / ППО")
  fullPath String?

  // Контакты
  inn     String? @unique
  address String?
  phone   String?
  email   String?

  // Председатель (общие поля)
  chairmanName     String? // ФИО председателя (дублируется для отображения)
  chairmanJobTitle String? // Должность председателя (из справочника должностей)

  // Связь с председателем по типу организации
  ppoChairman User? @relation("PPOHeadOrganization") // Для ППО
  mpoChairman User? @relation("MPOHeadOrganization") // Для МПО
  rpoChairman User? @relation("RPOHeadOrganization") // Для РПО

  // Статистика организации
  totalEmployees Int? @default(0) // Общее количество работников в организации (для расчёта % членства)

  // Члены
  members User[]

  // Документы организации
  documents Document[]

  // Журналы регистрации документов
  documentRegistries DocumentRegistry[]

  // Обращения (тикеты) организации
  tickets Ticket[] @relation("OrganizationTickets")

  // Каналы публикации новостей
  newsChannels NewsChannel[] @relation("OrganizationNewsChannels")

  // История членства
  membershipHistory MembershipHistory[]

  // Роли сотрудников организации
  staffRoles StaffRole[] @relation("OrganizationStaffRoles")

  // Сотрудники организации
  staffMembers OrganizationStaff[] @relation("OrganizationStaffMembers")

  // Приглашения сотрудников
  staffInvitations StaffInvitation[] @relation("OrganizationStaffInvitations")

  // Отчёты организации
  reports Report[] @relation("OrganizationReports")

  // Папки для чатов организации
  chatFolders ChatFolder[] @relation("OrganizationChatFolders")

  // Заседания профкома
  meetings Meeting[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связь с местами работы (для автоматического определения ППО)
  workplaceMappings WorkplacePPOMapping[] @relation("WorkplacePPOMapping")

  // Подписка (тариф, лимит участников, срок) — для ППО и организаций с платным доступом
  subscription OrganizationSubscription?
  payments     OrganizationPayment[]

  @@index([type])
  @@index([parentId])
  @@index([inn])
  @@index([level])
  @@index([sortOrder])
}

// Статус подписки организации
enum SubscriptionStatus {
  NONE       // Нет подписки
  TRIAL      // Пробный период (14 дней без карты)
  ACTIVE     // Оплаченная подписка активна
  EXPIRED    // Подписка истекла
  CANCELLED  // Отменена
}

// Подписка организации (тариф, лимит участников, срок)
model OrganizationSubscription {
  id String @id @default(cuid())

  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status SubscriptionStatus @default(NONE)

  // Лимит участников (null = безлимит, задаётся тарифом или суперадмином)
  memberLimit Int?

  // Тариф из прайса: ключ плана (50, 100, 500, 1000, 3600, UNLIMITED)
  tariffKey String?

  // Период подписки
  trialEndsAt    DateTime? // Окончание пробного периода (14 дней)
  periodEndsAt   DateTime? // Окончание оплаченного периода
  periodStartedAt DateTime? // Начало текущего оплаченного периода

  // Ручное управление суперадмином: доп. дни, свой лимит, безлимит, тест
  manualOverride   Boolean @default(false)
  addedDaysByAdmin Int?   // Доп. дни, добавленные админом
  adminNote        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments OrganizationPayment[]

  @@index([organizationId])
  @@index([status])
  @@index([periodEndsAt])
}

// Платёж организации (история)
model OrganizationPayment {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Связь с подпиской (оплата продлевает/активирует подписку)
  subscriptionId String?
  subscription   OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amountCents Int      // Сумма в копейках
  currency    String   @default("RUB")

  // Период, за который оплачено
  periodStart DateTime
  periodEnd   DateTime

  // Статус: PENDING, COMPLETED, FAILED, REFUNDED
  status String @default("PENDING")

  // Мок: внешний ID платежа (позже — id из платёжной системы)
  externalId String?

  // Метаданные: тариф, кол-во участников на момент оплаты
  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([createdAt])
}

// Справочник связи мест работы с ППО
// Используется для автоматического определения ППО по месту работы (название + ИНН)
model WorkplacePPOMapping {
  id String @id @default(cuid())

  // Место работы (идентифицируется по названию и ИНН)
  workplaceName String // Название организации места работы
  workplaceInn  String // ИНН организации места работы

  // Связь с ППО
  ppoOrganizationId String
  ppoOrganization   Organization @relation("WorkplacePPOMapping", fields: [ppoOrganizationId], references: [id], onDelete: Cascade)

  // Метаданные
  source   String? // Источник данных: "manual" (ручное добавление), "minjust" (из Минюста), "dadata" (из DaData)
  verified Boolean @default(false) // Проверено администратором
  notes    String? @db.Text // Примечания

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workplaceName, workplaceInn]) // Одна организация места работы может быть связана только с одним ППО
  @@index([workplaceInn])
  @@index([ppoOrganizationId])
  @@index([workplaceName])
}

// Типы документов
enum DocumentType {
  MEMBERSHIP_APPLICATION // Заявление о вступлении в ППО
  CONTRIBUTION_APPLICATION // Заявление о взносах
  MEMBERSHIP_REMOVAL_APPLICATION // Заявление о снятии с учета
  MEMBERSHIP_TRANSFER_APPLICATION // Заявление о переходе в другой профсоюз
  APPEAL // Обращение
  AGENDA // Повестка дня заседания профкома
  PROTOCOL // Протокол заседания профкома
  RESOLUTION // Постановление профсоюзного комитета
  PROTOCOL_EXTRACT // Выписка из протокола
  OTHER // Прочее
}

// Категории документов (для журнала)
enum DocumentCategory {
  INCOMING // Входящий документ
  OUTGOING // Исходящий документ
  INTERNAL // Внутренний документ
  DRAFT // Черновик
}

// Статусы документов (workflow)
enum DocumentStatus {
  DRAFT // Черновик
  GENERATED // Сгенерирован (готов к подписи)
  PENDING_REVIEW // На рассмотрении
  PENDING_APPROVAL // На согласовании
  PENDING_SIGNATURE // На подписи
  SIGNED // Подписан
  REGISTERED // Зарегистрирован
  SENT // Отправлен
  RECEIVED // Получен
  COMPLETED // Исполнен
  REJECTED // Отклонён
  ARCHIVED // В архиве
}

// Приоритет документа
enum DocumentPriority {
  LOW // Низкий
  NORMAL // Обычный
  HIGH // Высокий
  URGENT // Срочный
}

// Документ (заявления, обращения, документооборот)
model Document {
  id       String           @id @default(cuid())
  type     DocumentType
  status   DocumentStatus   @default(DRAFT)
  category DocumentCategory @default(INTERNAL)
  priority DocumentPriority @default(NORMAL)

  // Регистрация
  regNumber String? // Регистрационный номер
  regDate   DateTime? // Дата регистрации
  dueDate   DateTime? // Срок исполнения
  isUrgent  Boolean   @default(false)

  // Содержимое
  title       String
  content     String? @db.Text
  description String? @db.Text

  // Файлы (PDF и подписанные копии)
  filePath       String? // Сгенерированный PDF
  signedFilePath String? // Подписанный скан
  fileName       String? // Имя файла
  fileSize       Int? // Размер в байтах
  mimeType       String  @default("application/pdf")

  // Google Drive хранение
  driveFileId String? @unique // ID файла в Google Drive
  driveUrl    String? // Публичная ссылка на файл

  // Отправитель (для входящих документов)
  senderName         String? // ФИО отправителя
  senderOrganization String? // Организация отправителя
  senderRegNumber    String? // Исходящий номер отправителя
  senderDate         DateTime? // Дата исходящего документа

  // Получатель (для исходящих документов)
  recipientName         String? // ФИО получателя
  recipientOrganization String? // Организация получателя

  // Владелец/Создатель документа
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Организация
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Шаблон документа (если документ создан из шаблона)
  templateId String?
  template   DocumentTemplate? @relation("DocumentFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  // Workflow: Назначен на исполнение
  assignedToId   String?
  assignedTo     User?     @relation("DocumentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  executionNotes String?   @db.Text // Примечания для исполнителя

  // Workflow: Согласование
  approvedById String?
  approvedBy   User?     @relation("DocumentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // Workflow: Подписание
  signedById String?
  signedBy   User?     @relation("DocumentSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt   DateTime?

  // Связь с родительским документом (для ответов)
  parentDocumentId String?
  parentDocument   Document?  @relation("DocumentResponses", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  responses        Document[] @relation("DocumentResponses")

  // Связи с заседаниями профкома
  meetingAsAgenda     Meeting? @relation("MeetingAgendaDocument") // Этот документ - повестка дня заседания
  meetingAsProtocol   Meeting? @relation("MeetingProtocolDocument") // Этот документ - протокол заседания
  meetingResolutionId String? // Постановление относится к заседанию
  meetingResolution   Meeting? @relation("MeetingResolutions", fields: [meetingResolutionId], references: [id])
  meetingExtractId    String? // Выписка относится к заседанию
  meetingExtract      Meeting? @relation("MeetingExtracts", fields: [meetingExtractId], references: [id])

  // Комментарий при отклонении
  rejectionReason String? @db.Text

  // Метаданные документа (JSON) - для документов профкома
  metadata Json?

  // Верификация документа (AI-проверка)
  verificationStatus  String? // VERIFYING, VERIFIED, FAILED, NEEDS_REVIEW
  verificationMessage String?   @db.Text
  verifiedAt          DateTime?

  // История статусов
  statusHistory DocumentStatusHistory[]

  // Цепочка согласований
  approvals DocumentApproval[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([category])
  @@index([regNumber])
  @@index([regDate])
  @@index([assignedToId])
  @@index([parentDocumentId])
  @@index([priority])
  @@index([driveFileId])
  @@index([meetingResolutionId])
  @@index([meetingExtractId])
}

// История статусов документа
model DocumentStatusHistory {
  id             String          @id @default(cuid())
  documentId     String
  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status         DocumentStatus
  previousStatus DocumentStatus?
  changedById    String?
  changedBy      User?           @relation("DocumentStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  comment        String?         @db.Text
  changedAt      DateTime        @default(now())

  @@index([documentId])
  @@index([changedById])
}

// Цепочка согласований документа
model DocumentApproval {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("DocumentApprovalUser", fields: [userId], references: [id], onDelete: Cascade)
  order      Int       @default(1) // Порядок согласования
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  comment    String?   @db.Text
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// Журнал регистрации документов (для автонумерации)
model DocumentRegistry {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  category       DocumentCategory
  lastNumber     Int              @default(0)
  prefix         String? // Префикс номера (например, "ВХ", "ИСХ", "ВН")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, year, category])
}

// Шаблоны документов для конструктора
model DocumentTemplate {
  id          String       @id @default(cuid())
  name        String // Название шаблона
  description String?      @db.Text // Описание шаблона
  type        DocumentType // Тип документа (MEMBERSHIP_APPLICATION, CONTRIBUTION_APPLICATION и т.д.)

  // HTML содержимое шаблона с переменными (например, {{firstName}}, {{lastName}})
  htmlContent String @db.Text // HTML шаблон с переменными

  // CSS стили для шаблона
  cssStyles String? @db.Text // Дополнительные CSS стили

  // Метаданные
  isActive  Boolean @default(true) // Активен ли шаблон
  isDefault Boolean @default(false) // Шаблон по умолчанию для данного типа

  // Создатель и обновление
  createdByUserId String?
  createdBy       User?   @relation("DocumentTemplateCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedBy       User?   @relation("DocumentTemplateUpdatedBy", fields: [updatedByUserId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связь с документами, созданными из этого шаблона
  documents Document[] @relation("DocumentFromTemplate")

  @@unique([type, isDefault]) // Только один шаблон по умолчанию для каждого типа
  @@index([type])
  @@index([isActive])
  @@index([isDefault])
}

// ====== ДОКУМЕНТООБОРОТ ЗАСЕДАНИЙ ПРОФКОМА ======

// Тип заседания
enum MeetingType {
  COMMITTEE // Заседание профсоюзного комитета
  BUREAU // Заседание профбюро
  GROUP // Собрание профгруппы
  YOUTH_COUNCIL // Заседание молодежного совета
  PRESIDIUM // Заседание президиума
  GENERAL // Общее собрание
}

// Статус заседания
enum MeetingStatus {
  DRAFT // Черновик (подготовка)
  SCHEDULED // Запланировано
  IN_PROGRESS // Идёт заседание
  VOTING // Голосование (для онлайн)
  COMPLETED // Завершено
  CANCELLED // Отменено
}

// Формат заседания
enum MeetingFormat {
  OFFLINE // Очное
  ONLINE // Онлайн
  HYBRID // Смешанное
}

// Модель заседания (объединяет все документы заседания)
model Meeting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Информация о заседании
  type   MeetingType
  status MeetingStatus @default(DRAFT)
  format MeetingFormat @default(OFFLINE)

  // Номер и название
  number String? // Номер заседания в году (например, "1", "2")
  title  String? // Название/тема заседания

  // Дата и время
  scheduledDate DateTime // Запланированная дата
  scheduledTime String? // Время начала (HH:MM)
  actualStartAt DateTime? // Фактическое начало
  actualEndAt   DateTime? // Фактическое окончание

  // Место проведения
  location   String? // Место проведения
  onlineLink String? // Ссылка для онлайн-участия

  // Связи с документами
  agendaDocumentId String?   @unique // Повестка дня (Document с type=AGENDA)
  agendaDocument   Document? @relation("MeetingAgendaDocument", fields: [agendaDocumentId], references: [id])

  protocolDocumentId String?   @unique // Протокол (Document с type=PROTOCOL)
  protocolDocument   Document? @relation("MeetingProtocolDocument", fields: [protocolDocumentId], references: [id])

  // Участники и пункты повестки
  participants MeetingParticipant[]
  agendaItems  MeetingAgendaItem[]

  // Постановления и выписки (на основе протокола)
  resolutions Document[] @relation("MeetingResolutions")
  extracts    Document[] @relation("MeetingExtracts")

  // Протокол: избранные на заседании (заполняются на шаге протокола)
  presidingOfficerUserId String? // Председательствующий (из выборного органа)
  secretaryUserId        String? // Секретарь заседания (из выборного органа)
  voteCounterUserIds     String? @db.Text // JSON: массив userId ответственных за подсчёт голосов

  // Созыватель/Организатор (опционально: при удалении пользователя можно обнулить в коде)
  createdById String?
  createdBy   User?  @relation("MeetingCreatedBy", fields: [createdById], references: [id])

  // Метаданные
  notes String? @db.Text // Примечания

  // Групповой чат заседания (создаётся при отправке на согласование; председатель — админ)
  groupChat Chat? @relation("MeetingGroupChat")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([scheduledDate])
}

// Роль участника заседания
enum MeetingParticipantRole {
  CHAIRMAN // Председатель заседания
  SECRETARY // Секретарь
  MEMBER // Член профкома (с правом голоса)
  INVITED // Приглашённый (без права голоса)
  OBSERVER // Наблюдатель
}

// Статус присутствия
enum MeetingAttendanceStatus {
  INVITED // Приглашён
  CONFIRMED // Подтвердил участие
  PRESENT // Присутствует (очно, для обратной совместимости)
  PRESENT_OFFLINE // Присутствовал очно
  PRESENT_ONLINE // Присутствовал онлайн
  ABSENT // Отсутствовал
  EXCUSED // Отсутствует по уважительной причине
}

// Участники заседания
model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Связь с пользователем (если есть в системе)
  userId String?
  user   User?   @relation("UserMeetingParticipations", fields: [userId], references: [id], onDelete: SetNull)

  // Данные участника (для участников не из системы)
  externalName     String? // ФИО внешнего участника
  externalPosition String? // Должность внешнего участника

  // Роль и статус
  role       MeetingParticipantRole  @default(MEMBER)
  attendance MeetingAttendanceStatus @default(INVITED)

  // Доступ к голосованию
  canVote  Boolean @default(true) // Имеет право голоса
  hasVoted Boolean @default(false) // Проголосовал (для онлайн)

  // Время отметки присутствия
  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
  @@index([role])
  @@index([attendance])
}

// Пункт повестки дня (вопрос)
model MeetingAgendaItem {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Номер и текст вопроса
  orderNumber Int // Порядковый номер вопроса (1, 2, 3...)
  title       String // Краткое название вопроса
  description String? @db.Text // Подробное описание

  // СЛУШАЛИ
  heardText String? @db.Text // Текст "Слушали"

  // ДОКЛАДЫВАЛ
  speakerId       String? // ID докладчика (User)
  speaker         User?   @relation("AgendaItemSpeaker", fields: [speakerId], references: [id])
  speakerName     String? // ФИО докладчика (если не из системы)
  speakerPosition String? // Должность докладчика
  // Со-докладчик (в документ в клеточку «докладывал»)
  coSpeakerId   String?
  coSpeaker     User?   @relation("AgendaItemCoSpeaker", fields: [coSpeakerId], references: [id])
  coSpeakerName String?

  // ПОСТАНОВИЛИ
  resolutionText String? @db.Text // Текст постановления

  // РЕШИЛИ (после голосования)
  decidedText String? @db.Text // Текст решения (необязательное поле)

  // Голосование
  votes           MeetingAgendaVote[]
  votesFor        Int                 @default(0) // За
  votesAgainst    Int                 @default(0) // Против
  votesAbstained  Int                 @default(0) // Воздержались
  votingCompleted Boolean             @default(false) // Голосование завершено

  // Статус вопроса
  isApproved Boolean? // Принят / Не принят

  // Прикреплённые файлы/документы
  attachments String? @db.Text // JSON массив файлов

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId])
  @@index([orderNumber])
}

// Голосование по пункту повестки
model MeetingAgendaVote {
  id           String            @id @default(cuid())
  agendaItemId String
  agendaItem   MeetingAgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)

  // Голосующий
  participantId String? // Связь с MeetingParticipant (если через систему)
  userId        String? // Связь с User напрямую
  user          User?   @relation("UserAgendaVotes", fields: [userId], references: [id])
  voterName     String? // ФИО (для ручного ввода)

  // Голос
  vote    String // "FOR", "AGAINST", "ABSTAINED"
  comment String? // Комментарий к голосу

  // Время голосования
  votedAt DateTime @default(now())

  @@unique([agendaItemId, userId])
  @@index([agendaItemId])
  @@index([userId])
}

// Удалено: ChatSession и ChatMessage - больше не используются
// Чат-бот теперь работает без сессий, просто как помощник на всех страницах

// Удалено: Новости (для будущего функционала) - не используется
// Удалено: Скидки (для будущего функционала) - не используется

// Настройки системы (SMTP, OpenRouter и т.д.)
model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String?  @db.Text
  updatedByUserId String?
  updatedBy       User?    @relation("SystemSettingUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([key])
}

