// База знаний (Knowledge Base) - как в Coze
model KnowledgeBase {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  // Документы в базе знаний
  documents KnowledgeDocument[]
  sources   KnowledgeSource[]
  chunks    KnowledgeChunk[]

  // Боты, использующие эту базу знаний
  bots ChatBotKnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Типы документов в базе знаний
enum KnowledgeSourceType {
  FILE
  URL
  WEB_SEARCH
  API
  MANUAL
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

enum ProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model KnowledgeSource {
  id              String                @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase         @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  type            KnowledgeSourceType
  url             String?
  title           String?
  metadata        Json?
  status          KnowledgeSourceStatus @default(PENDING)
  lastFetchedAt   DateTime?
  documents       KnowledgeDocument[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([type])
}

model KnowledgeDocument {
  id              String           @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          KnowledgeSource? @relation(fields: [sourceId], references: [id])

  // Метаданные файла
  fileName     String?
  originalName String
  filePath     String?
  mimeType     String?
  fileType     String?
  fileSize     Int?
  checksum     String?
  contentType  DocumentContentType @default(TEXT)

  // Обработка
  processingStatus ProcessingStatus @default(UPLOADED)
  processedAt      DateTime?
  extractedText    String?          @db.Text
  meta             Json?

  uploadedByUserId String?
  uploadedBy       User?   @relation("KnowledgeDocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  chunks KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([sourceId])
  @@index([processingStatus])
  @@index([contentType])
}

model KnowledgeChunk {
  id              String             @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId      String?
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content         String             @db.Text
  tokens          Int?
  embedding       Float[]
  metadata        Json?
  createdAt       DateTime           @default(now())

  @@index([knowledgeBaseId])
  @@index([documentId])
}

// База знаний о пользователе (для ИИ)
// Автоматически создается для каждого пользователя и хранит всю информацию о нем
model UserKnowledgeBase {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserKnowledgeBase", fields: [userId], references: [id], onDelete: Cascade)

  // Chunks с информацией о пользователе
  chunks UserKnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Фрагменты информации о пользователе с векторными представлениями
model UserKnowledgeChunk {
  id                  String            @id @default(cuid())
  userKnowledgeBaseId String
  userKnowledgeBase   UserKnowledgeBase @relation(fields: [userKnowledgeBaseId], references: [id], onDelete: Cascade)

  // Тип информации
  type UserKnowledgeChunkType

  // Содержимое фрагмента
  content String @db.Text

  // Векторное представление для поиска
  embedding Float[]

  // Метаданные (JSON)
  metadata Json?

  // Количество токенов
  tokens Int?

  // Источник информации (например, "profile_update", "ai_interaction", "document_generation")
  source String

  // Ссылка на связанную сущность (например, ID документа или сообщения)
  relatedEntityId   String?
  relatedEntityType String? // "document", "chat_message", "profile_update"

  createdAt DateTime @default(now())

  @@index([userKnowledgeBaseId])
  @@index([type])
  @@index([source])
  @@index([relatedEntityId])
}

// Типы фрагментов информации о пользователе
enum UserKnowledgeChunkType {
  PROFILE_DATA // Данные профиля (ФИО, телефон, адрес и т.д.)
  INTERACTION // Взаимодействие с ИИ (вопросы, ответы)
  DOCUMENT_CONTENT // Содержимое документов пользователя
  PREFERENCE // Предпочтения и настройки
  HISTORY // История действий (вступление, изменения статуса и т.д.)
  NOTE // Заметки администратора о пользователе
}

// Настройки AI бота (промпт, тон, контекст)
model ChatBot {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text

  // Системный промпт
  systemPrompt String @db.Text

  // Тон общения
  tone String @default("professional") // professional, friendly, formal, casual

  // Контекст (дополнительная информация)
  context String? @db.Text

  // Модель AI (например: openai/gpt-4o-mini, anthropic/claude-3-haiku и т.д.)
  model String @default("openai/gpt-4o-mini")

  // API провайдер
  apiProviderId String?
  apiProvider   ApiProvider? @relation(fields: [apiProviderId], references: [id])

  // Дополнительные настройки (для кастомных провайдеров или переопределений)
  providerOverride Json?

  // Температура для генерации (0-2)
  temperature Float @default(0.7)

  // Максимальное количество токенов (увеличено для поддержки сложных диалогов и развернутых ответов)
  // 16000 tokens ≈ 12000 слов - достаточно для самых сложных объяснений
  maxTokens Int @default(16000)

  // Базы знаний, используемые этим ботом
  knowledgeBases  ChatBotKnowledgeBase[]
  retrievalConfig Json?

  // Удалено: связь с ChatMessage (ChatMessage больше не используется)

  // Активен ли бот
  isActive Boolean @default(true)

  // Является ли ботом по умолчанию
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDefault])
  @@index([apiProviderId])
}

// Связь бота с базой знаний (many-to-many)
model ChatBotKnowledgeBase {
  id              String        @id @default(cuid())
  chatBotId       String
  chatBot         ChatBot       @relation(fields: [chatBotId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([chatBotId, knowledgeBaseId])
  @@index([chatBotId])
  @@index([knowledgeBaseId])
}

// Настройки API провайдеров (OpenRouter, OpenAI, Anthropic и т.д.)
model ApiProvider {
  id          String  @id @default(cuid())
  name        String  @unique // openrouter, openai, anthropic, custom
  displayName String // Отображаемое имя
  description String? @db.Text

  // API ключ (зашифрован или в открытом виде, зависит от реализации)
  apiKey String? @db.Text

  // Базовый URL для API
  apiBaseUrl String? @db.Text

  // Доступные модели для этого провайдера (JSON массив)
  availableModels String? @db.Text // JSON массив моделей
  capabilities    Json?

  // Активен ли провайдер
  isActive Boolean @default(true)

  // Является ли провайдером по умолчанию
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots ChatBot[]

  @@index([isActive])
  @@index([isDefault])
}

// Система тикетов (обращений)
enum TicketType {
  LEGAL // Юридическое обращение
  ACCOUNTING // Бухгалтерское обращение
  TECHNICAL // Техническая поддержка
  HR // Кадровые вопросы
  OTHER // Прочее
}

enum TicketStatus {
  PENDING // Ожидание
  IN_PROGRESS // В работе
  RESOLVED // Решено
  REJECTED // Отклонено
  CLOSED // Закрыто
}

enum TicketPriority {
  LOW // Низкая
  MEDIUM // Средняя
  HIGH // Высокая
  URGENT // Срочная
}

model Ticket {
  id String @id @default(cuid())

  // 8-значный публичный ID для отслеживания (10000000-99999999)
  publicId String @unique @db.Char(8)

  userId String
  user   User   @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)

  // Основная информация
  type     TicketType
  status   TicketStatus   @default(PENDING)
  priority TicketPriority @default(MEDIUM)
  title    String
  content  String         @db.Text // HTML контент с WYSIWYG

  // Файлы, прикрепленные к тикету
  attachments TicketAttachment[]

  // Ответы на тикет (комментарии)
  comments TicketComment[]
  
  // Журнал действий
  actionLogs TicketActionLog[]

  // Метаданные
  tags       String? // JSON массив тегов для аналитики
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  
  // Связь с чатом
  chatId String? @unique
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)
  
  // Причина отклонения (для Председателя)
  rejectionReason String? @db.Text
  
  // Рейтинг полезности ответа (1-5, заполняется членом профсоюза)
  helpfulRating Int?
  helpfulRatingComment String? @db.Text // Комментарий к оценке
  helpfulRatingAt DateTime? // Когда была выставлена оценка
  
  // Организация (для фильтрации обращений Председателем)
  organizationId String?
  organization   Organization? @relation("OrganizationTickets", fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([publicId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// Вложения к тикету
model TicketAttachment {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileName String
  filePath String // Путь к файлу в файловой системе
  fileSize Int // Размер в байтах
  mimeType String

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Комментарии к тикету (ответы)
model TicketComment {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserTicketComments", fields: [userId], references: [id], onDelete: Cascade)

  content String @db.Text // HTML контент с WYSIWYG

  // Файлы, прикрепленные к комментарию
  attachments TicketCommentAttachment[]

  isInternal Boolean @default(false) // Внутренний комментарий (виден только админам)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

// Вложения к комментарию
model TicketCommentAttachment {
  id String @id @default(cuid())

  commentId String
  comment   TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  fileSize Int
  mimeType String

  createdAt DateTime @default(now())

  @@index([commentId])
}

// Журнал действий по обращениям (для логирования всех действий Председателя)
model TicketActionLog {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Кто выполнил действие
  userId String
  user   User   @relation("UserTicketActions", fields: [userId], references: [id], onDelete: Cascade)

  // Тип действия
  actionType String // "created", "updated", "replied", "rejected", "approved", "deleted", "message_edited", "status_changed"

  // Описание действия
  description String @db.Text

  // Старое и новое значение (для отслеживания изменений)
  oldValue String? @db.Text
  newValue String? @db.Text

  // Метаданные (JSON)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
}

// Push Notifications (Firebase Cloud Messaging)
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Firebase Cloud Messaging token
  fcmToken       String? @unique // FCM registration token (nullable for legacy records)
  subscriptionId String? // Legacy field (kept for compatibility)

  // Legacy OneSignal fields (deprecated, will be removed)
  oneSignalId String? // Deprecated: OneSignal Player ID

  lastSyncAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([fcmToken])
  @@index([oneSignalId]) // Legacy index
}

model DiscountPreference {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushEnabled Boolean @default(false)
  filters     Json?
  geolocation Json?

  lastNotificationAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pushEnabled])
}

// Активированные скидки пользователя с промокодами и сроками действия
model DiscountActivation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("DiscountActivations", fields: [userId], references: [id], onDelete: Cascade)
  discountId   Int      // ID скидки из BestBenefits
  promoCode    String?  // Промокод (сохраняем локально, даже если BestBenefits очистит)
  activatedAt  DateTime @default(now()) // Дата активации
  validUntil   DateTime? // Срок действия скидки (из BestBenefits API)
  syncedFromBB Boolean  @default(false) // Синхронизировано ли из BestBenefits
  lastSyncedAt DateTime? // Когда последний раз синхронизировали с BestBenefits

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, discountId])
  @@index([userId])
  @@index([discountId])
  @@index([validUntil])
}

// Уведомления пользователя (история всех уведомлений)
model UserNotification {
  id String @id @default(cuid())

  // Пользователь-получатель
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Тип уведомления
  type String // "chat_message", "news_published", "post_comment", "ticket_response", etc.

  // Содержимое уведомления
  title String
  body  String @db.Text

  // URL для перехода при клике
  url String?

  // Метаданные (JSON) - может содержать дополнительные данные (senderId, newsId, ticketId, etc.)
  metadata Json?

  // Прочитано ли уведомление
  readAt DateTime?

  // Отправлено ли через push/email
  pushSent  Boolean @default(false)
  emailSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}

// Логирование системных ошибок и событий
enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SystemLog {
  id String @id @default(cuid())

  level      LogLevel @default(INFO)
  source     String // API endpoint, component name, etc
  message    String
  details    Json?
  stackTrace String?

  // Связь с пользователем (если ошибка произошла в контексте пользователя)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Метаданные для анализа
  metadata Json?

  // Статус разрешения ошибки
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedByUser User?     @relation("ResolvedLogs", fields: [resolvedBy], references: [id], onDelete: SetNull)

  // Уведомление отправлено?
  notificationSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([source])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId])
}

// Новости
// Каналы публикации новостей
model NewsChannel {
  id String @id @default(cuid())

  // Название канала
  name String

  // Описание канала
  description String? @db.Text

  // Иконка канала (URL или base64)
  iconUrl String? @db.Text

  // Организация, которой принадлежит канал
  organizationId String?
  organization   Organization? @relation("OrganizationNewsChannels", fields: [organizationId], references: [id], onDelete: Cascade)

  // Создатель канала
  createdById String
  createdBy   User   @relation("NewsChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)

  // Является ли канал основным (по умолчанию для организации)
  isMain Boolean @default(false)

  // Новости в канале
  newsPosts NewsPost[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@index([isMain])
}

model NewsPost {
  id String @id @default(cuid())

  // Автор (супер-админ или Председатель)
  authorId String
  author   User   @relation("NewsPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Канал публикации
  channelId String?
  channel   NewsChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  // Основная информация
  title      String
  content    String  @db.Text // HTML контент с WYSIWYG
  coverImage String? @db.Text // Data URL изображения (base64) или внешний URL

  // Опубликовано ли
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Статистика
  viewCount Int @default(0)

  // Связи
  likes    NewsLike[]
  views    NewsView[]
  comments NewsComment[]
  polls    NewsPoll[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([channelId])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([createdAt])
}

// Лайки новостей
model NewsLike {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([newsPostId, userId])
  @@index([newsPostId])
  @@index([userId])
}

// Просмотры новостей (отслеживание уникальных просмотров)
model NewsView {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsViewUser", fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([newsPostId, userId])
  @@index([newsPostId])
  @@index([userId])
  @@index([viewedAt])
}

// История членства в профсоюзе
model MembershipHistory {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Организация, в которой состоял на учете
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationName String? // Название организации (для истории, если организация удалена)

  // Статус в этой организации
  status String // ACCEPTED (принят на учет), REMOVED (снят с учета), TRANSFERRED (переведен)

  // Даты
  statusDate DateTime // Дата изменения статуса
  notes      String?  @db.Text // Дополнительные заметки

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([statusDate])
}

// Комментарии к новостям
model NewsComment {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsCommentUser", fields: [userId], references: [id], onDelete: Cascade)

  // Ответ на другой комментарий (для вложенных комментариев)
  parentId String?
  parent   NewsComment?  @relation("NewsCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  NewsComment[] @relation("NewsCommentReplies")

  content String @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsPostId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

// Опросы в новостях
model NewsPoll {
  id String @id @default(cuid())

  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  question String
  options  Json // Массив вариантов ответов: [{id: string, text: string}]

  // Завершен ли опрос
  isClosed Boolean   @default(false)
  closesAt DateTime?

  // Голоса
  votes NewsPollVote[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsPostId])
  @@index([isClosed])
}

// Голоса в опросах
model NewsPollVote {
  id String @id @default(cuid())

  pollId String
  poll   NewsPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("NewsPollVoteUser", fields: [userId], references: [id], onDelete: Cascade)

  optionId String // ID выбранного варианта ответа

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

// Справочник должностей
model JobTitle {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Справочник профессий
model Profession {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Подписки пользователей друг на друга (для уведомлений о готовности чата)
model UserSubscription {
  id String @id @default(cuid())

  // Подписчик (кто подписывается)
  subscriberId String
  subscriber   User   @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)

  // На кого подписан
  targetUserId String
  targetUser   User   @relation("UserSubscribers", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Настройки уведомлений
  emailNotifications Boolean @default(true) // Email уведомления
  pushNotifications  Boolean @default(true) // Push уведомления

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriberId, targetUserId])
  @@index([subscriberId])
  @@index([targetUserId])
  @@index([createdAt])
}

// Тип чата
enum ChatType {
  PRIVATE // Личный чат между двумя пользователями
  GROUP   // Групповой чат
}

// Чаты между пользователями
model Chat {
  id String @id @default(cuid())

  // Тип чата
  type ChatType @default(PRIVATE)

  // Участники чата (для личных чатов - два пользователя)
  participant1Id String?
  participant1   User?   @relation("ChatParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)

  participant2Id String?
  participant2   User?   @relation("ChatParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)

  // Для групповых чатов
  name        String? // Название группы
  description String? @db.Text // Описание группы
  iconUrl     String? @db.Text // Иконка группы
  isPublic    Boolean  @default(true) // Публичный или закрытый (для групповых чатов)
  createdById String? // Создатель группы
  createdBy   User?   @relation("ChatCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Участники группового чата
  participants ChatParticipant[]

  // Последнее сообщение (для сортировки)
  lastMessageAt DateTime?
  lastMessage   String?   @db.Text

  // Кто прочитал последнее сообщение (для личных чатов)
  participant1ReadAt DateTime?
  participant2ReadAt DateTime?

  // Сообщения в чате
  messages ChatMessage[]
  
  // Связь с обращением (тикетом)
  ticket Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participant1Id, participant2Id], name: "unique_private_chat")
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([createdById])
  @@index([type])
  @@index([lastMessageAt])
}

// Участники группового чата
model ChatParticipant {
  id String @id @default(cuid())

  chatId String
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("ChatParticipants", fields: [userId], references: [id], onDelete: Cascade)

  // Роль в группе
  role String @default("member") // "admin", "member"

  // Приглашен кем
  invitedById String?
  invitedBy   User?   @relation("ChatInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  // Прочитано ли последнее сообщение
  readAt DateTime?

  // Timestamps
  joinedAt DateTime @default(now())
  leftAt   DateTime?

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@index([role])
}

// Сообщения в чатах
model ChatMessage {
  id String @id @default(cuid())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Отправитель
  senderId String
  sender   User   @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Текст сообщения
  content String @db.Text

  // Ответ на сообщение (reply)
  replyToId String?
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  // Пересылка сообщения (forward)
  forwardedFromId String?
  forwardedFrom   ChatMessage?  @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        ChatMessage[] @relation("MessageForwards")

  // Вложения (файлы, изображения)
  attachments ChatMessageAttachment[]

  // Прочитано ли сообщение
  readAt DateTime?

  // Редактирование и удаление
  editedAt  DateTime?
  deletedAt DateTime?

  // Реакции на сообщение (JSON: { "emoji": ["userId1", "userId2"], ... })
  reactions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
  @@index([replyToId])
  @@index([deletedAt])
  @@index([chatId, deletedAt, createdAt]) // Составной индекс для оптимизации пагинации
}

// Вложения к сообщениям в чате
model ChatMessageAttachment {
  id String @id @default(cuid())

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Тип вложения
  type String // "image", "file", "video"

  // Файл
  fileName     String
  originalName String
  filePath     String  @db.Text
  fileSize     Int
  mimeType     String?

  // Превью для изображений
  thumbnailPath String? @db.Text

  createdAt DateTime @default(now())

  @@index([messageId])
}

// Посты пользователей (стена)
model UserPost {
  id String @id @default(cuid())

  // Автор поста
  authorId String
  author   User   @relation("UserPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Контент поста
  content String @db.Text

  // Тип поста
  postType String @default("text") // "text", "image", "link", "video", "file"

  // Вложения
  attachments PostAttachment[]

  // Метаданные для ссылок и видео
  linkMetadata  Json? // {url, title, description, image, siteName} для ссылок
  videoMetadata Json? // {provider: "youtube"|"rutube"|"vk", videoId, embedUrl} для видео

  // Обложка для статей
  coverImage String? @db.Text // URL изображения обложки для статей

  // Статистика
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  viewCount     Int @default(0)

  // Связи
  likes    PostLike[]
  views    PostView[]
  comments PostComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([postType])
}

// Вложения к постам
model PostAttachment {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Тип вложения
  type String // "image", "file", "video"

  // Файл
  fileName     String
  originalName String
  filePath     String  @db.Text
  fileSize     Int
  mimeType     String?

  // Превью для изображений и файлов
  thumbnailPath String? @db.Text

  createdAt DateTime @default(now())

  @@index([postId])
}

// Лайки постов
model PostLike {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// Просмотры постов (отслеживание уникальных просмотров)
model PostView {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PostViewUser", fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([viewedAt])
}

// Комментарии к постам
model PostComment {
  id String @id @default(cuid())

  postId String
  post   UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PostCommentUser", fields: [userId], references: [id], onDelete: Cascade)

  // Ответ на другой комментарий (для вложенных комментариев)
  parentId String?
  parent   PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PostComment[] @relation("PostCommentReplies")

  content String @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}
