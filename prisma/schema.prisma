// База знаний (Knowledge Base) - как в Coze
model KnowledgeBase {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  // Документы в базе знаний
  documents KnowledgeDocument[]
  sources   KnowledgeSource[]
  chunks    KnowledgeChunk[]

  // Боты, использующие эту базу знаний
  bots ChatBotKnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Типы документов в базе знаний
enum KnowledgeSourceType {
  FILE
  URL
  WEB_SEARCH
  API
  MANUAL
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

enum ProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model KnowledgeSource {
  id              String               @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase        @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  type            KnowledgeSourceType
  url             String?
  title           String?
  metadata        Json?
  status          KnowledgeSourceStatus @default(PENDING)
  lastFetchedAt   DateTime?
  documents       KnowledgeDocument[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([type])
}

model KnowledgeDocument {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          KnowledgeSource? @relation(fields: [sourceId], references: [id])

  // Метаданные файла
  fileName   String?
  originalName String
  filePath   String?
  mimeType   String?
  fileType   String?
  fileSize   Int?
  checksum   String?
  contentType DocumentContentType @default(TEXT)

  // Обработка
  processingStatus ProcessingStatus @default(UPLOADED)
  processedAt      DateTime?
  extractedText    String? @db.Text
  meta             Json?

  uploadedByUserId String?
  uploadedBy       User?   @relation("KnowledgeDocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  chunks    KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([sourceId])
  @@index([processingStatus])
  @@index([contentType])
}

model KnowledgeChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId      String?
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content         String @db.Text
  tokens          Int?
  embedding       Float[]
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([knowledgeBaseId])
  @@index([documentId])
}

// Настройки AI бота (промпт, тон, контекст)
model ChatBot {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text

  // Системный промпт
  systemPrompt String @db.Text

  // Тон общения
  tone String @default("professional") // professional, friendly, formal, casual

  // Контекст (дополнительная информация)
  context String? @db.Text

  // Модель AI (например: openai/gpt-4o-mini, anthropic/claude-3-haiku и т.д.)
  model String @default("openai/gpt-4o-mini")

  // API провайдер
  apiProviderId String?
  apiProvider   ApiProvider? @relation(fields: [apiProviderId], references: [id])

  // Дополнительные настройки (для кастомных провайдеров или переопределений)
  providerOverride Json?

  // Температура для генерации (0-2)
  temperature Float @default(0.7)

  // Максимальное количество токенов
  maxTokens Int @default(1000)

  // Базы знаний, используемые этим ботом
  knowledgeBases ChatBotKnowledgeBase[]
  retrievalConfig Json?

  // Сообщения, созданные этим ботом
  messages ChatMessage[]

  // Активен ли бот
  isActive Boolean @default(true)

  // Является ли ботом по умолчанию
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDefault])
  @@index([apiProviderId])
}

// Связь бота с базой знаний (many-to-many)
model ChatBotKnowledgeBase {
  id              String        @id @default(cuid())
  chatBotId       String
  chatBot         ChatBot       @relation(fields: [chatBotId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([chatBotId, knowledgeBaseId])
  @@index([chatBotId])
  @@index([knowledgeBaseId])
}

// Настройки API провайдеров (OpenRouter, OpenAI, Anthropic и т.д.)
model ApiProvider {
  id          String  @id @default(cuid())
  name        String  @unique // openrouter, openai, anthropic, custom
  displayName String // Отображаемое имя
  description String? @db.Text

  // API ключ (зашифрован или в открытом виде, зависит от реализации)
  apiKey String? @db.Text

  // Базовый URL для API
  apiBaseUrl String? @db.Text

  // Доступные модели для этого провайдера (JSON массив)
  availableModels String? @db.Text // JSON массив моделей
  capabilities   Json?

  // Активен ли провайдер
  isActive Boolean @default(true)

  // Является ли провайдером по умолчанию
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots ChatBot[]

  @@index([isActive])
  @@index([isDefault])
}

// Типы обращений
enum AppealType {
  LEGAL // Юридический вопрос
  ACCOUNTING // Бухгалтерский вопрос
  TECHNICAL // Технический вопрос
  OTHER // Прочее
}

// Статусы обращений
enum AppealStatus {
  DRAFT // Черновик
  SUBMITTED // Отправлено
  IN_REVIEW // На рассмотрении
  RESOLVED // Решено
  REJECTED // Отклонено
}

// Обращения пользователей (для аналитики и обработки)
model UserAppeal {
  id String @id @default(cuid())

  // 8-значный публичный ID для отслеживания (10000000-99999999)
  publicId String @unique @db.Char(8)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   AppealType
  status AppealStatus @default(DRAFT)

  // Основная информация
  title       String
  description String @db.Text
  question    String @db.Text

  // Связь с чатом
  chatMessages ChatMessage[]

  // Метаданные
  tags       String? // JSON массив тегов для аналитики
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([publicId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Аналитика обращений
model AppealAnalytics {
  id String @id @default(cuid())

  appealType AppealType

  // Статистика
  totalCount    Int @default(0)
  resolvedCount Int @default(0)

  // Теги и ключевые слова для анализа
  commonKeywords String? @db.Text // JSON массив ключевых слов

  // Время средне обработки (в часах)
  averageResolutionTime Float?

  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appealType, periodStart, periodEnd])
  @@index([appealType])
  @@index([periodStart])
}

// Push Notifications
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OneSignal subscription data
  oneSignalId   String // User ID in OneSignal
  subscriptionId String? // Subscription ID for the device

  lastSyncAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, oneSignalId])
  @@index([userId])
  @@index([oneSignalId])
}

// Логирование системных ошибок и событий
enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SystemLog {
  id String @id @default(cuid())

  level LogLevel @default(INFO)
  source String // API endpoint, component name, etc
  message String
  details Json?
  stackTrace String?

  // Связь с пользователем (если ошибка произошла в контексте пользователя)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Метаданные для анализа
  metadata Json?

  // Статус разрешения ошибки
  resolved Boolean @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  resolvedByUser User? @relation("ResolvedLogs", fields: [resolvedBy], references: [id], onDelete: SetNull)

  // Уведомление отправлено?
  notificationSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([source])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId])
}

// Системные настройки (для супер-админа)
model SystemSettings {
  id String @id @default("system_settings")
  
  // OneSignal конфигурация
  oneSignalAppId String?
  oneSignalRestApiKey String?
  
  // Другие настройки
  maintenanceMode Boolean @default(false)
  maintenanceMessage String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
