# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (не коммитить секреты)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# любые варианты .env.* кроме шаблона для репозитория
.env.*
!.env.example
*.env.bak
.env*.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/migrations/migration_lock.toml

# logs
*.log
server.log

# temp files
check-bot.mjs

# Deploy credentials
.deploy/
*.deploy.env
deploy-config.sh
SERVER_ACCESS.md

# Uploaded files live only on production server
/public/uploads/**
!/public/uploads/**/.gitkeep

# PDF documents
*.pdf
# Статические PDF в репозитории (лендинг, демо)
!public/offerta.pdf
!public/demo/*.pdf

# Export files
document-templates-export.json
exports/
backups/
profreport-main/
trade-union-survey-system/
