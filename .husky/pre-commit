#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Запуск тестов перед коммитом..."

# Проверка TypeScript
echo "📝 Проверка TypeScript..."
npm run type-check || {
  echo "❌ Ошибки TypeScript! Исправьте перед коммитом."
  exit 1
}

# Проверка линтера
echo "🔍 Проверка линтера..."
npm run lint || {
  echo "⚠️  Предупреждения линтера (не критично)"
}

echo "✅ Предварительные проверки пройдены"
