#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Запуск проверок перед коммитом..."
echo ""

# Проверка TypeScript
echo "📝 Проверка TypeScript типов..."
pnpm type-check || {
  echo ""
  echo "❌ Ошибки TypeScript! Коммит заблокирован."
  echo "   Исправьте ошибки и повторите попытку."
  exit 1
}

# Проверка линтера (блокируем при ошибках)
echo ""
echo "🔍 Проверка ESLint..."
npx next lint || {
  echo ""
  echo "❌ Ошибки ESLint! Коммит заблокирован."
  echo "   Исправьте ошибки и повторите попытку."
  exit 1
}

echo ""
echo "✅ Все проверки пройдены успешно!"
