      "get": {
        "tags": [
          "Города"
        ],
        "summary": "Получить список городов по запросу",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Часть названия города для фильтрации",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список городов, соответствующих запросу",
