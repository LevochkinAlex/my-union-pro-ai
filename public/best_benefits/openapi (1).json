{
  "openapi": "3.0.0",
  "info": {
    "title": "BestBenefits API",
    "description": "",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://bestbenefits.ru/api/",
      "description": "BestBenefits API"
    }
  ],
  "paths": {
    "/company/login": {
      "post": {
        "tags": [
          "Ссылка для аутентификации"
        ],
        "summary": "Аутентификация пользователя по ссылке",
        "description": "Ссылка одноразовая и живет 3 минуты",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/wp_login_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                }
              }
            }
          },
          "401": {
            "description": "Ошибка авторизации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_401"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/auth": {
      "post": {
        "tags": [
          "Аутентификация"
        ],
        "summary": "Аутентификация пользователя",
        "description": "Принимает email и password, возвращает токен для авторизации.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/auth_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Успешная аутентификация",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_1"
                }
              }
            }
          },
          "401": {
            "description": "Ошибка аутентификации (неправильные данные)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_401"
                }
              }
            }
          },
          "403": {
            "description": "Токен истек",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_403"
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Категории"
        ],
        "summary": "Получить список категорий",
        "description": "Возвращает все категории и подкатегории",
        "operationId": "getCategories",
        "responses": {
          "200": {
            "description": "Все категории",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoriesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Предложения"
        ],
        "summary": "Получить список предложений",
        "description": "Возвращает список продуктов с поддержкой пагинации. Пользователь должен быть аутентифицирован через Bearer токен.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "ID категории для фильтрации",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Название города для фильтрации",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ с данными предложений",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_2"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Bearer токен не найден или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_401"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/products/{id}": {
      "get": {
        "tags": [
          "Предложения"
        ],
        "summary": "Получение подробной информации о предложении",
        "description": "Возвращает подробные данные о товаре по указанному ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID предложения",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "integer",
              "example": 1436
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ с данными предложения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_3"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка, товар не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_400"
                }
              }
            }
          },
          "401": {
            "description": "Ошибка аутентификации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_401"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "Предложения"
        ],
        "summary": "Поиск предложений по запросу",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Поисковый запрос",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Название города для фильтрации (например, Москва, Санкт-Петербург, Казань)",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Результаты поиска",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_4"
                },
                "example": {
                  "data": [
                    {
                      "id": 17,
                      "name": "Готовая правильная еда с доставкой от justfood",
                      "image": "iVBORw0KGgoAAAANSUhEUg...",
                      "main_category": {
                        "id": 18,
                        "name": "Рестораны и доставка"
                      },
                      "categories": [
                        {
                          "id": 18,
                          "name": "Рестораны и доставка"
                        }
                      ],
                      "isFavorite": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Bearer токен не найден или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_401"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/favorites": {
      "get": {
        "tags": [
          "Избранное"
        ],
        "summary": "Получение избранных предложений",
        "description": "Возвращает список избранных предложений. Пользователь должен быть аутентифицирован через Bearer токен.",
        "responses": {
          "200": {
            "description": "Успешное получение данных",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_5"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Bearer токен не найден или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_401"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Избранное"
        ],
        "summary": "Добавление или удаление из избранного",
        "description": "Добавляет или удаляет товар из избранного. Пользователь должен быть аутентифицирован через Bearer токен.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "ID предложения, которое нужно добавить или удалить из избранного",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "example": 17
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешное добавление или удаление из избранного",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_6"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка, товар не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_400"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Bearer токен не найден или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_401"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/viewed": {
      "get": {
        "tags": [
          "Предложения"
        ],
        "summary": "Недавно просмотренные предложения",
        "description": "Возвращает информацию о недавно просмотренных предложениях. Пользователь должен быть аутентифицирован через Bearer токен.",
        "responses": {
