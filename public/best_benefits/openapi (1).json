    "/promo": {
      "post": {
        "tags": [
          "Купоны"
        ],
        "summary": "Получить купон",
        "description": "Позволяет пользователю получить промокод. Пользователь должен быть аутентифицирован через Bearer токен.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/promo_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Успешное получение промокода",
