  "components": {
    "schemas": {
      "Subcategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 4
          },
          "order": {
            "type": "integer",
            "example": 2
          },
          "name": {
            "type": "string",
            "example": "Бытовая техника"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "order": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Техника и Электроника"
          },
          "subcategory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subcategory"
            }
          }
        }
      },
      "CategoriesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "wp_login_body": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID пользователя",
            "example": "123"
          },
          "city": {
            "type": "integer",
            "description": "ID города",
            "example": 1
          }
        }
      },
      "inline_response_200": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "url": {
            "type": "string",
            "example": "https://bestbenefits.ru/code?q=example_string"
          }
        }
      },
      "inline_response_401": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Unauthorized"
          }
        }
      },
      "auth_body": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "yourpassword"
          }
        }
      },
      "inline_response_200_1": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "your_access_token"
          }
        }
      },
      "inline_response_403": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "expired"
          },
          "token": {
            "type": "string",
            "example": "new_access_token"
          },
          "message": {
            "type": "string",
            "example": "Токен истек"
          }
        }
      },
      "inline_response_200_2": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
