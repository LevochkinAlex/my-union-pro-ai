          "description": {
            "type": "string",
            "example": "<p dir=\"ltr\" style=\"line-height: 1.656; margin-top: 0pt; margin-bottom: 0pt;\"><span style=\"font-size: 13pt; font-family: 'Open Sans',sans-serif; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\">● Скидки в сервисе доставки</span></p>"
