      "get": {
        "tags": [
          "Купоны"
        ],
        "summary": "Получение подробной информации о взятых купонах по предложениям",
        "description": "Возвращает информацию о взятых купонах по предложениям. Пользователь должен быть аутентифицирован через Bearer токен.",
        "responses": {
          "200": {
            "description": "Успешное получение данных",
            "content": {
              "application/json": {
