          },
          "meta": {
            "$ref": "#/components/schemas/inline_response_200_2_meta"
          }
        }
      },
      "inline_response_200_3": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1436
          },
          "name": {
            "type": "string",
            "example": "Сервис доставки САМОКАТ"
          },
          "image": {
            "type": "string",
