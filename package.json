{
  "name": "my-union-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev -p 3004",
    "build": "dotenv -e .env.local -- next build",
    "start": "dotenv -e .env.local -- next start -p 3004",
    "lint": "next lint",
    "prisma:migrate": "dotenv -e .env.local -- pnpm prisma migrate dev",
    "prisma:studio": "dotenv -e .env.local -- pnpm prisma studio",
    "prisma:generate": "dotenv -e .env.local -- pnpm prisma generate",
    "prisma:push": "dotenv -e .env.local -- pnpm prisma db push",
    "prisma:reset": "dotenv -e .env.local -- pnpm prisma migrate reset --force",
    "prisma:validate": "dotenv -e .env.local -- pnpm prisma validate",
    "seed:default-bot": "dotenv -e .env.local -- node scripts/create-default-bot.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.65",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/multer": "^2.0.0",
    "ai": "^5.0.92",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.29.0",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "docxtemplater": "^3.67.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "flatpickr": "^4.6.13",
    "ioredis": "^5.4.1",
    "jspdf": "^3.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.553.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "next": "16.0.1",
    "next-auth": "4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "prisma": "^6.19.0",
    "puppeteer": "^24.29.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.66.0",
    "react-input-mask": "^2.0.4",
    "strip-ansi": "^7.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.12"
