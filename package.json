{
  "name": "my-union-pro",
  "version": "1.10.7-beta.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "postinstall": "prisma generate",
    "fix-appeal-messages": "tsx scripts/fix-appeal-messages.ts",
    "rebuild-appeal-statuses": "dotenv -e .env.local -- tsx scripts/rebuild-appeal-statuses.ts",
    "rebuild-meeting-chats": "dotenv -e .env.local -- tsx scripts/rebuild-meeting-chats-for-user.ts",
    "cleanup:orphan-incoming-copies": "dotenv -e .env.local -- tsx scripts/cleanup-orphan-incoming-meeting-copies.ts",
    "cleanup:orphan-meeting-documents": "dotenv -e .env.local -- tsx scripts/cleanup-orphan-meeting-documents.ts",
    "delete:resolution-copies-inbox": "dotenv -e .env.local -- tsx scripts/delete-resolution-copies-inbox.ts",
    "rebuild-all-meeting-chats": "dotenv -e .env.local -- tsx scripts/rebuild-all-meeting-chats.ts",
    "dev": "dotenv -e .env.local -- next dev -p 3004 --webpack",
    "dev:clean": "rm -rf .next && dotenv -e .env.local -- next dev -p 3004 --webpack",
    "dev:turbo": "dotenv -e .env.local -- next dev -p 3004 --turbopack",
    "prebuild": "pnpm prisma:generate",
    "build": "dotenv -e .env.local -- next build",
    "start": "dotenv -e .env.local -- next start -p 3004",
    "docs:pdf": "node scripts/md-to-pdf-docs.mjs",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test __tests__/documents-helpers.test.ts __tests__/chat-flows.test.ts __tests__/meeting-agenda-notify.test.ts __tests__/meeting-document-approval-api.test.ts __tests__/login-copy.test.ts __tests__/auth-translit.test.ts __tests__/news-publication.test.ts __tests__/staff-permissions-matrix.test.ts __tests__/document-workflow-permissions.test.ts __tests__/dictionaries-job-titles.test.ts __tests__/security-role-access.test.ts __tests__/workplace-inn.test.ts",
    "test:chat": "node --import tsx --test __tests__/chat-flows.test.ts",
    "test:news": "node --import tsx --test __tests__/news-publication.test.ts",
    "test:api": "dotenv -e .env.local -- node scripts/test-tickets-api.mjs",
    "test:security:runtime": "node --test scripts/security-role-runtime-smoke.mjs",
    "test:ticket-flow": "dotenv -e .env.local -- node scripts/test-ticket-creation-flow.mjs",
    "test:registration-flow": "dotenv -e .env.local -- npx tsx scripts/test-registration-flow.ts",
    "pre-deploy": "dotenv -e .env.local -- node scripts/pre-deploy-check.mjs",
    "prisma:migrate": "dotenv -e .env.local -- pnpm prisma migrate dev",
    "prisma:studio": "dotenv -e .env.local -- pnpm prisma studio",
    "prisma:generate": "pnpm prisma generate || dotenv -e .env.local -- pnpm prisma generate",
    "prisma:push": "dotenv -e .env.local -- pnpm prisma db push",
    "prisma:reset": "dotenv -e .env.local -- pnpm prisma migrate reset --force",
    "prisma:validate": "dotenv -e .env.local -- pnpm prisma validate",
    "create-super-admin": "dotenv -e .env.local -- node scripts/create-super-admin.mjs",
    "prisma:fix": "bash scripts/fix-prisma.sh",
    "seed:default-bot": "dotenv -e .env.local -- node scripts/create-default-bot.mjs",
    "seed:document-templates": "dotenv -e .env.local -- node scripts/seed-document-templates.mjs",
    "seed:reports": "dotenv -e .env.local -- npx tsx prisma/seed-reports.ts",
    "seed:demo-chairmen": "dotenv -e .env.local -- tsx scripts/seed-demo-chairmen.ts",
    "export:templates": "dotenv -e .env.local -- node scripts/export-document-templates.mjs",
    "import:templates": "dotenv -e .env.local -- node scripts/import-document-templates.mjs",
    "migrate:files-to-vds": "dotenv -e .env.local -- node scripts/migrate-files-to-vds.mjs",
    "cleanup:documents": "node scripts/cleanup-old-documents.mjs",
    "worker": "dotenv -e .env.local -- tsx scripts/worker.ts",
    "worker:prod": "node dist/scripts/worker.js",
    "load-documents": "dotenv -e .env.local -- node scripts/load-appeal-bot-documents.mjs",
    "reset-user": "dotenv -e .env.local -- tsx scripts/reset-user-data.ts",
    "generate-icons": "node scripts/generate-icons.mjs",
    "sync:promo-codes": "dotenv -e .env.local -- tsx scripts/sync-all-users-promo-codes.ts",
    "sync:discounts": "dotenv -e .env.local -- node scripts/sync-discounts.mjs",
    "sync:all-users-discounts": "dotenv -e .env.local -- tsx scripts/sync-all-users-discounts.ts",
    "bb:reset-all-passwords": "dotenv -e .env.local -- tsx scripts/reset-all-bb-user-passwords.ts",
    "sync:channel-posts-to-news": "dotenv -e .env.local -- tsx scripts/sync-channel-posts-to-news.ts",
    "fix:news-cover-images": "dotenv -e .env.local -- tsx scripts/fix-news-cover-image-paths.ts",
    "delete:test-news-post": "dotenv -e .env.local -- tsx scripts/delete-test-news-post.ts",
    "roles:bootstrap-rpo-templates": "dotenv -e .env.local -- tsx scripts/bootstrap-rpo-role-templates.ts",
    "roles:migrate-permissions": "dotenv -e .env.local -- tsx scripts/migrate-role-permissions-to-defaults.ts",
    "socket": "dotenv -e .env.local -- tsx server/socket-server.ts",
    "socket:chat": "dotenv -e .env.local -- tsx server/chat-server.ts",
    "socket:build": "npx esbuild server/socket-server.ts --bundle --platform=node --outfile=dist/server/socket-server.js --external:@prisma/client --external:prisma",
    "socket:prod": "node dist/server/socket-server.js"
  },
