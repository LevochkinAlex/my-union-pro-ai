{
  "name": "my-union-pro",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev -p 3004",
    "prebuild": "pnpm prisma:generate",
    "build": "dotenv -e .env.local -- next build",
    "start": "dotenv -e .env.local -- next start -p 3004",
    "lint": "next lint",
    "prisma:migrate": "dotenv -e .env.local -- pnpm prisma migrate dev",
    "prisma:studio": "dotenv -e .env.local -- pnpm prisma studio",
    "prisma:generate": "pnpm prisma generate || dotenv -e .env.local -- pnpm prisma generate",
    "prisma:push": "dotenv -e .env.local -- pnpm prisma db push",
    "prisma:reset": "dotenv -e .env.local -- pnpm prisma migrate reset --force",
    "prisma:validate": "dotenv -e .env.local -- pnpm prisma validate",
    "prisma:fix": "bash scripts/fix-prisma.sh",
    "seed:default-bot": "dotenv -e .env.local -- node scripts/create-default-bot.mjs",
    "seed:document-templates": "dotenv -e .env.local -- node scripts/seed-document-templates.mjs",
    "export:templates": "dotenv -e .env.local -- node scripts/export-document-templates.mjs",
    "import:templates": "dotenv -e .env.local -- node scripts/import-document-templates.mjs",
    "migrate:files-to-vds": "dotenv -e .env.local -- node scripts/migrate-files-to-vds.mjs",
    "worker": "dotenv -e .env.local -- tsx scripts/worker.ts",
    "worker:prod": "node dist/scripts/worker.js",
    "load-documents": "dotenv -e .env.local -- node scripts/load-appeal-bot-documents.mjs",
    "reset-user": "dotenv -e .env.local -- tsx scripts/reset-user-data.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.65",
    "@hookform/resolvers": "^5.2.2",
    "@maxhub/max-bot-api": "^0.2.1",
    "@prisma/client": "^6.19.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tinymce/tinymce-react": "^6.3.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.6",
    "ai": "^5.0.92",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.29.0",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "flatpickr": "^4.6.13",
    "ioredis": "^5.4.1",
    "jsbarcode": "^3.12.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.553.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "next": "16.0.1",
    "next-auth": "4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.0",
    "puppeteer": "^24.29.1",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-easy-crop": "^5.5.5",
    "react-hook-form": "^7.66.0",
    "react-input-mask": "^2.0.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "strip-ansi": "^7.1.0",
    "tailwind-merge": "^3.4.0",
    "tinymce": "^8.2.2",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "rimraf": "^6.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
